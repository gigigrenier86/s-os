[Desktop Entry]
Type=Application
Version=1.0
Name=PowerPoint
GenericName=Présentations
Comment=Microsoft PowerPoint sur le web, dans une fenêtre dédiée — le vrai Microsoft 365, sans Wine
Exec=/usr/lib/opt/vivaldi/vivaldi --app=https://powerpoint.cloud.microsoft/
Icon=x-office-presentation
Terminal=false
StartupNotify=true
StartupWMClass=vivaldi-powerpoint.cloud.microsoft__-Default
Categories=Office;Presentation;
Keywords=powerpoint;microsoft;office;presentation;diaporama;
