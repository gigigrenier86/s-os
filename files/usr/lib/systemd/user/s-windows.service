[Unit]
Description=S - le Windows resident
Documentation=man:wineserver(1)

# POURQUOI CETTE UNITE EXISTE.
#
# Un wineserver lance depuis un script meurt avec le groupe de processus de ce
# script. Mesure du 2026-08-26 : demarre a la main avec « -p », il a servi trois
# lancements a 0,24 s puis a disparu entre deux commandes du meme banc. Il n'y a
# pas de « detache-toi bien » qui tienne — c'est au gestionnaire de session de
# porter un processus qui doit survivre a son lanceur.
#
# CE QU'ELLE CHANGE, MESURE SUR CETTE MACHINE :
#   umu-run cmd /c exit                        5,06 s
#   wine direct, serveur froid                 1,66 s
#   wine direct, serveur resident              0,24 s
#
# Elle se leve avec la session et retombe avec elle : le Windows de S demarre
# une fois, comme un vrai systeme, au lieu de renaitre a chaque double-clic.
PartOf=s-session.target
After=s-session.target

# UNE PANNE PERSISTANTE DOIT S'ARRETER ET SE VOIR, PAS TOURNER A VIDE.
#
# Le 2026-09-18, le serveur a redemarre 62 fois en 16 minutes sans que
# « systemctl --failed » en dise un mot : chaque tour dure ~13 s (l'amorce
# attend dix secondes un serveur qui ne viendra pas), donc la limite par defaut
# de systemd — cinq departs en dix secondes — n'etait JAMAIS atteinte. Une
# unite en « activating » ou « auto-restart » n'est pas « failed » ; on la
# croyait saine parce que l'outil de controle ne la comptait pas.
#
# Cinq departs en cinq minutes suffisent : au-dela, l'unite passe en
# « failed (start-limit-hit) », ce qui se voit — et ce qui rend enfin le
# processeur.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple

# LA MEME FAILLE LATENTE QUE s-sora.service PORTAIT, TROUVEE ET CORRIGEE LE
# 2026-09-02 : « DefaultTimeoutStartUSec » vaut 45 s par defaut dans systemd
# (compile en dur, jamais surcharge dans /usr/lib/systemd/user.conf sur cette
# machine) et borne TOUTE la transaction de demarrage, ExecCondition et
# ExecStartPost compris — pas seulement ExecStart. Le tiret en tete de
# l'amorce (voir plus bas) ne protege que du code de sortie, jamais de la
# duree.
#
# Jamais declenchee ici en usage normal : l'amorce attend au plus 10 s le
# serveur (voir s-windows --amorcer) puis un seul « cmd /c exit », mesure a
# 215-2565 ms. Mais un disque lent ou un premier client qui met plus de temps
# a monter la session Windows suffirait a reproduire exactement ce qui a tue
# Sora cinq fois de suite le meme soir — mieux vaut une marge large que de
# suivre le chiffre mesure au plus juste.
TimeoutStartSec=180

# SI LE WINDOWS DE S N'EST PAS PRET POUR CETTE VERSION DE PROTON, IL N'Y A RIEN
# A SERVIR.
#
# Une unite qui echoue a chaque ouverture de session serait du bruit, et le
# bruit finit par etre ignore — y compris le jour ou il dit quelque chose.
# « ExecCondition » fait sauter l'unite sans la marquer en echec : c'est
# exactement la nuance qu'il faut ici. C'est s-ouvrir-exe qui construit le
# prefixe au premier usage, et qui le remet a jour apres un changement de
# Proton, puis demarre cette unite lui-meme.
#
# LA VERSION D'AVANT NE TESTAIT QUE L'EXISTENCE DU PREFIXE (« test -d
# .../drive_c »). Or le prefixe survit aux mises a jour d'image, et pas le
# dossier du Proton que l'image demande : la premiere mise a jour qui changeait
# de version (GE-Proton11-6 vers 11-7) laissait le prefixe en place, le serveur
# cherchait un dossier absent, et l'unite redemarrait a l'infini. « --pret »
# teste les quatre conditions de s_windows_pret, version de Proton comprise.
ExecCondition=/usr/bin/s-windows --pret

ExecStart=/usr/bin/s-windows --serveur

# LE SERVEUR GARDE LE PREFIXE, IL N'OUVRE PAS LA SESSION WINDOWS — et sans cette
# ligne c'est l'utilisateur qui l'ouvre, sur son premier double-clic.
#
# Chronometre sur un vrai demarrage le 2026-08-26, serveur debout depuis une
# heure et quart, aucun programme Windows lance depuis l'ouverture de session :
#
#   1er lancement    2565 ms     services.exe et rpcss.exe avaient 4 s d'age
#   suivants          215 ms
#
# « - » en tete : une amorce ratee ne doit pas emporter le serveur resident. Le
# pire cas sans amorce est le comportement d'avant, pas une panne.
ExecStartPost=-/usr/bin/s-windows --amorcer

# « -k » demande au serveur de sortir proprement : il previent les programmes
# Windows encore ouverts au lieu de les faucher. Un programme qui n'a pas eu le
# temps d'ecrire ses fichiers a la fermeture de session, c'est un document
# perdu, et ce projet a deja paye assez cher les fins de course silencieuses.
ExecStop=/usr/bin/s-windows --arreter-serveur
TimeoutStopSec=20

Restart=on-failure
RestartSec=2

[Install]
WantedBy=s-session.target
