[Unit]
Description=S - partage du disque Windows du double amorcage
Documentation=man:systemd-mount(1)
# apres que les disques locaux soient la, avant que quiconque se connecte —
# le lien ~/Windows doit deja exister quand un compte s'ouvre une session.
After=local-fs.target
Before=display-manager.service
ConditionPathExists=/etc/plasma-setup-done

[Service]
Type=oneshot
ExecStart=/usr/bin/s-monter-windows
RemainAfterExit=no

[Install]
WantedBy=multi-user.target
