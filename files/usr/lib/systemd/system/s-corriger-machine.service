[Unit]
Description=S - sudo actif et session par defaut, des la creation du compte
Documentation=man:usermod(8)
# apres plasma-setup : le compte doit exister avant qu'on puisse le corriger.
# avant display-manager : la premiere connexion doit deja voir un compte
# administrateur et S preselectionnee, sans avoir a redemarrer une fois pour
# rien.
After=plasma-setup.service
Before=display-manager.service
ConditionPathExists=/etc/plasma-setup-done

[Service]
Type=oneshot
ExecStart=/usr/bin/s-corriger-machine
RemainAfterExit=no

[Install]
WantedBy=multi-user.target
