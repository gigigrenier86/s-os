#!/usr/bin/bash
# S — partager le disque Windows du double amorcage, sans redemarrer pour
# aller y chercher un fichier.
#
# CE QUE S PEUT SAVOIR A LA CONSTRUCTION, ET CE QU'IL NE PEUT PAS. La partition
# Windows existe sur le disque interne de CETTE machine, mais son UUID est
# propre a cette installation Windows precise — le graver dans l'image
# rendrait chaque machine differente cassee au demarrage suivant, et une
# reinstallation de Windows sur la MEME machine changerait cet UUID. C'est
# exactement le probleme que s-corriger-machine resout deja pour le compte :
# ce qui n'existe qu'au moment du demarrage se decouvre au moment du
# demarrage, jamais avant.
#
# LA CIBLE EST CHOISIE PAR TAILLE, PAS PAR NOM, ET PLUS PAR « INTERNE ».
# Ce script filtrait sur RM=0, c'est-a-dire « disque non amovible » : il ne
# regardait que le disque interne. C'etait juste tant que Windows vivait sur le
# NVMe de la M720q. Le 2026-08-23 il a ete decide de l'inverse — S natif sur le
# NVMe, Windows clone sur la Seagate, un disque USB — et ce filtre aurait alors
# fait exactement ce que ce depot s'interdit : ne rien trouver, ne rien dire, et
# laisser ~/Windows vide sans qu'une seule commande echoue.
#
# Ce qui remplace le filtre : un PLANCHER DE TAILLE. Une installation Windows
# ne tient pas sous 40 Gio ; une partition de recuperation (WinRE) n'en depasse
# jamais quelques-uns. Le plancher ecarte donc ce que RM=0 ecartait — les
# petites partitions de service — sans ecarter le disque qui compte. Il ecarte
# aussi, au passage, la cle USB de quelqu'un qui passe : personne ne promene
# 40 Gio de NTFS sur un porte-cles.
#
# Si aucune partition NTFS n'existe — S installe seul, sans Windows — ce script
# se tait et ne pose rien : rien d'inconditionnel quand la machine peut repondre.
#
# NON VERIFIE AU MOMENT D'ECRIRE CECI : ce script n'a jamais tourne via ce
# service, sur aucune machine. Il a ete valide en deux morceaux, a la main,
# sur la M720q le 2026-08-23 : la detection lsblk rend bien nvme0n1p3 (237 Go)
# et jamais nvme0n1p4 (853 Mo, la partition de recuperation), et un montage
# manuel via udisks (donc en tant qu'utilisateur, pas ce service) a confirme
# qu'aucune hibernation n'empeche une monte en lecture-ecriture. La commande
# systemd-mount ci-dessous, elle, n'a jamais ete executee — la permission
# d'invoquer sudo depuis cette session a ete refusee par prudence. A confirmer
# au premier vrai demarrage avec le correctif.
set -uo pipefail

dire() { printf 's-monter-windows : %s\n' "$*" >&2; }

CIBLE=/var/mnt/windows
PLANCHER=$((40 * 1024 * 1024 * 1024))   # 40 Gio — voir l'en-tete

# --- Trouver la partition Windows : la plus grosse NTFS au-dessus du plancher
#
# SORTIE EN CLE="VALEUR", ET C'EST UNE CORRECTION. La forme « -r » de lsblk
# separe ses colonnes par un espace et n'ecrit RIEN pour un champ vide : deux
# espaces de suite, que awk recolle en un seul. Un disque sans systeme de
# fichiers reconnu decale alors toutes les colonnes suivantes, et la taille se
# compare a un chemin. La forme « -P » nomme chaque champ : elle ne peut pas se
# decaler, quoi qu'il manque.
#
# Et on la lit en awk, pas par « eval », qui serait plus court : un des champs
# s'appelle PATH, et l'evaluer ecraserait le PATH du shell — apres quoi plus
# une seule commande de ce script ne se trouverait.
TOUTES="$(
    lsblk -Pbo TYPE,FSTYPE,SIZE,PATH 2>/dev/null | awk '
        /TYPE="part"/ && /FSTYPE="ntfs"/ {
            t = ""; c = ""
            if (match($0, /SIZE="[0-9]+"/))  t = substr($0, RSTART + 6, RLENGTH - 7)
            if (match($0, /PATH="[^"]+"/))   c = substr($0, RSTART + 6, RLENGTH - 7)
            if (t != "" && c != "") print t, c
        }'
)"

mapfile -t CANDIDATS < <(
    printf '%s\n' "$TOUTES" | awk -v min="$PLANCHER" 'NF==2 && $1+0 >= min' | sort -rn -k1,1
)

if [[ ${#CANDIDATS[@]} -eq 0 ]]; then
    # On dit ce qu'on a ecarte, sinon « rien a monter » ne distingue pas
    # « pas de Windows » de « une NTFS trop petite pour mon plancher ».
    ecartees="$(printf '%s\n' "$TOUTES" | awk 'NF==2 {printf "%s (%d Go) ", $2, $1/1024/1024/1024}')"
    if [[ -n "$ecartees" ]]; then
        dire "aucune NTFS d'au moins 40 Go — ecartees : $ecartees"
    else
        dire "aucune partition NTFS trouvee — rien a monter"
    fi
    exit 0
fi

read -r TAILLE PERIPH <<<"${CANDIDATS[0]}"
dire "cible choisie : $PERIPH ($((TAILLE / 1024 / 1024 / 1024)) Go, la plus grosse NTFS d'au moins 40 Go)"

# --- Deja monte ? Ne pas dupliquer a chaque demarrage ----------------------
if findmnt -no SOURCE "$CIBLE" >/dev/null 2>&1; then
    dire "$CIBLE deja monte — rien a refaire"
    exit 0
fi

mkdir -p "$CIBLE"

# systemd-mount cree l'unite .mount ET l'unite .automount d'un coup, sans
# fichier statique a poser dans l'image : le montage reel n'arrive qu'au
# premier acces au dossier, pas au demarrage. --collect nettoie l'unite
# automatiquement si le montage echoue ou est demonte plus tard.
if systemd-mount --no-block --collect --automount=yes \
    --description="S - disque Windows (C:)" \
    -t ntfs -o "rw,uid=1000,gid=1000,windows_names" \
    "$PERIPH" "$CIBLE"; then
    dire "$CIBLE : montage automatique arme (declenche au premier acces)"
else
    dire "ECHEC : systemd-mount a refuse $PERIPH -> $CIBLE"
fi

# --- Un lien Windows dans chaque compte humain, comme s-corriger-machine ---
mapfile -t COMPTES < <(awk -F: '$3>=1000 && $3<60000 && $7 !~ /(nologin|false)$/ {print $1, $6}' /etc/passwd)
for ligne in "${COMPTES[@]}"; do
    compte="${ligne%% *}"
    maison="${ligne#* }"
    lien="$maison/Windows"
    if [[ -L "$lien" ]]; then
        continue
    elif [[ -e "$lien" ]]; then
        dire "ATTENTION : $lien existe deja et n'est pas un lien — rien touche"
    else
        ln -s "$CIBLE" "$lien"
        chown -h "$compte": "$lien" 2>/dev/null || true
        dire "$compte : ~/Windows pointe vers $CIBLE"
    fi
done
