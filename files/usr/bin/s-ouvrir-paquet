#!/usr/bin/bash
# Double-clic sur un .deb ou un .rpm : ca s'installe, et l'icone arrive au menu.
#
# Le systeme est atomique : on n'ajoute rien au systeme lui-meme. Le paquet est
# pose dans un conteneur qui reste invisible, et distrobox-export fait remonter
# son lanceur dans le menu de l'hote. L'utilisateur ne voit qu'une icone.
set -uo pipefail
source /usr/bin/s-monde

CIBLE="${1:-}"
[ -n "$CIBLE" ] || s_echec "Rien a installer" "s-ouvrir-paquet attend un chemin."
CIBLE="$(readlink -f "$CIBLE")"
[ -f "$CIBLE" ] || s_echec "Fichier introuvable" "$CIBLE"
NOM="$(basename "$CIBLE")"

case "${CIBLE,,}" in
    *.deb) BOITE=s-debian ; IMAGE=docker.io/library/debian:stable ;;
    *.rpm) BOITE=s-fedora ; IMAGE=registry.fedoraproject.org/fedora:latest ;;
    *)     s_echec "Format inconnu" "$NOM n'est ni un .deb ni un .rpm." ;;
esac

s_verrou "$BOITE"

# Le conteneur ne partage que $HOME : le paquet doit y passer pour etre lisible.
DEPOT="$S_DATA/paquets"; mkdir -p "$DEPOT"
cp -f "$CIBLE" "$DEPOT/$NOM"

if ! podman container exists "$BOITE" 2>/dev/null; then
    s_dire "Premiere utilisation" "Preparation de l'environnement $BOITE, une minute."
    if ! distrobox create --image "$IMAGE" --name "$BOITE" --yes \
            >"$S_ETAT/$BOITE-init.log" 2>&1; then
        s_echec "L'environnement $BOITE n'a pas pu etre cree" "Detail dans $S_ETAT/$BOITE-init.log"
    fi
fi

s_dire "$NOM" "Installation…" package-x-generic

if [ "$BOITE" = s-debian ]; then
    PAQUET="$(dpkg-deb -f "$CIBLE" Package 2>/dev/null || true)"
    POSE="sudo apt-get update -qq && sudo apt-get install -y -qq \"\$1\""
    LISTE="dpkg -L"
else
    PAQUET="$(rpm -qp --qf '%{NAME}' "$CIBLE" 2>/dev/null || true)"
    POSE="sudo dnf install -y -q \"\$1\""
    LISTE="rpm -ql"
fi

if ! distrobox enter --name "$BOITE" -- bash -c "$POSE" _ "$DEPOT/$NOM" \
        >"$S_ETAT/$BOITE-pose.log" 2>&1; then
    s_echec "$NOM n'a pas pu etre installe" "Detail dans $S_ETAT/$BOITE-pose.log"
fi

# --- Faire remonter les lanceurs dans le menu de l'hote ---------------------
POSES=0
if [ -n "$PAQUET" ]; then
    while IFS= read -r desk; do
        app="$(basename "$desk" .desktop)"
        distrobox enter --name "$BOITE" -- distrobox-export --app "$app" \
            >>"$S_ETAT/$BOITE-pose.log" 2>&1 && POSES=$((POSES + 1))
    done < <(distrobox enter --name "$BOITE" -- bash -c \
                "$LISTE \"\$1\" 2>/dev/null | grep '[.]desktop\$'" _ "$PAQUET" 2>/dev/null)
fi

s_rafraichir_menu
if [ "$POSES" -gt 0 ]; then
    s_dire "$NOM" "Installe. $POSES icone(s) ajoutee(s) au menu." package-x-generic
else
    s_dire "$NOM" "Installe, mais sans lanceur graphique : c'est un outil en ligne de commande." package-x-generic
fi
