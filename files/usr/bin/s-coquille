#!/usr/bin/bash
# La coquille de S — le pont, puis Constellation, et un filet dessous.
#
# C'est ici que S cesse d'etre une base habillee : la coquille est TOUT ce que
# l'utilisateur voit. Le compositeur, lui, ne s'annonce jamais — voir s-session.
#
# LE FILET, ET POURQUOI IL EXISTE : une machine dont le bureau ne demarre pas
# est irreparable pour qui n'a pas de seconde machine. Si Constellation ne tient
# pas debout, cette coquille ne laisse pas un ecran noir : elle repose un bureau
# de secours et le dit. On perd l'apparence, jamais la machine.
set -uo pipefail

PORT="${S_ETOILES_PORT:-7373}"
export S_ETOILES_PORT="$PORT"
ADRESSE="http://127.0.0.1:${PORT}/"

# Le navigateur qui porte la coquille est un MOTEUR, pas une application : il
# n'a ni onglet, ni barre d'adresse, ni menu, et son profil est le sien.
#
# On vise le chemin de l'IMAGE, jamais /usr/bin/vivaldi-stable. Ce dernier est
# un lien vers /opt/vivaldi/vivaldi, qui ne resout que si systemd-tmpfiles a
# refait le pont /var/opt au demarrage — et c'est exactement ce qui a manque sur
# la machine reelle le 2026-08-21 : « Impossible de trouver le programme
# /usr/bin/vivaldi-stable ». Le bureau de S ne peut pas dependre d'un lien qui
# se refait a chaque allumage.
MOTEUR=""
for essai in /usr/lib/opt/vivaldi/vivaldi /usr/bin/vivaldi-stable \
             /usr/bin/chromium-browser /usr/bin/chromium; do
    [[ -x "$essai" ]] && { MOTEUR="$essai"; break; }
done

PROFIL="${XDG_DATA_HOME:-$HOME/.local/share}/s/coquille"
JOURNAL="${XDG_STATE_HOME:-$HOME/.local/state}/s"
mkdir -p "$PROFIL" "$JOURNAL"

dire() { printf 's-coquille : %s\n' "$*" >&2; }

# --- Le pont ---------------------------------------------------------------
/usr/bin/s-etoiles >>"$JOURNAL/etoiles.log" 2>&1 &
PONT=$!
# Attendre qu'il ECOUTE, plutot que de dormir un temps arbitraire : un delai
# fixe est trop long quand tout va bien et trop court quand la machine rame.
# Le disque de S est un plateau USB — un demarrage lent n'y est pas anormal.
attendu=0
until exec 3<>"/dev/tcp/127.0.0.1/${PORT}" 2>/dev/null; do
    exec 3>&- 2>/dev/null || true
    kill -0 "$PONT" 2>/dev/null || { dire "le pont est mort au demarrage"; break; }
    (( attendu++ >= 100 )) && { dire "le pont n'ecoute toujours pas"; break; }
    sleep 0.1
done
exec 3>&- 2>/dev/null || true

nettoyer() { kill "$PONT" 2>/dev/null || true; }
trap nettoyer EXIT

# --- Constellation ---------------------------------------------------------
lancer_coquille() {
    "$MOTEUR" \
        --app="$ADRESSE" \
        --user-data-dir="$PROFIL" \
        --class=SConstellation \
        --window-name=Constellation \
        --start-fullscreen \
        --no-first-run \
        --no-default-browser-check \
        --disable-features=Translate,MediaRouter \
        --ozone-platform-hint=auto \
        >>"$JOURNAL/coquille.log" 2>&1
}

# --- Le filet --------------------------------------------------------------
# Trois chutes en moins d'une minute = ce n'est pas un accident, c'est une
# panne. On arrete de rejouer et on repose un bureau utilisable.
secours() {
    dire "Constellation ne tient pas — bureau de secours"
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -u critical "S" \
            "Constellation n'a pas demarre. Bureau de secours ouvert. Le journal est dans ~/.local/state/s/." || true
    fi
    if command -v plasmashell >/dev/null 2>&1; then
        exec plasmashell
    elif command -v konsole >/dev/null 2>&1; then
        exec konsole
    else
        dire "aucun bureau de secours disponible"
        exec sleep infinity
    fi
}

if [[ -z "$MOTEUR" ]]; then
    dire "aucun moteur de rendu trouve pour la coquille"
    secours
fi

chutes=0
depart=$SECONDS
while true; do
    lancer_coquille
    code=$?

    # UN BUREAU NE SE FERME PAS PAR ACCIDENT. La coquille est une fenetre ;
    # Alt+F4 la ferme proprement, code 0, et sans ce qui suit la session
    # s'arreterait la — l'utilisateur perdrait tout parce qu'il a manque un
    # raccourci. On ne s'arrete donc que si le pont a pose le temoin, c'est-a-dire
    # si « Se deconnecter », « Redemarrer » ou « Eteindre » a ete choisi.
    if [[ -f "$JOURNAL/quitter" ]]; then
        rm -f "$JOURNAL/quitter"
        dire "sortie demandee par l'utilisateur"
        break
    fi
    if (( code == 0 )); then
        dire "coquille fermee sans demande de sortie — on la rouvre"
        continue
    fi

    (( SECONDS - depart > 60 )) && { chutes=0; depart=$SECONDS; }
    (( ++chutes >= 3 )) && secours
    dire "coquille tombee (code $code) — reprise $chutes/3"
    sleep 1
done
