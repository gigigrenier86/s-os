#!/usr/bin/bash
# La coquille de S — Constellation, et un filet dessous.
#
# C'est ici que S cesse d'etre une base habillee : la coquille est TOUT ce que
# l'utilisateur voit. Le compositeur, lui, ne s'annonce jamais — voir s-session.
#
# CE QUI A CHANGE LE 2026-08-24, ET C'EST LE CŒUR DE LA DEMANDE. Cette coquille
# lancait Vivaldi en « --app=http://127.0.0.1:7373/ » : le bureau de S etait une
# page web dans un navigateur sans barre d'adresse. Trois consequences que
# personne n'avait ecrites noir sur blanc :
#
#   - une mise a jour de Vivaldi pouvait casser le bureau ;
#   - le pont ouvrait un port sur la machine pour se parler a lui-meme ;
#   - LE CLIC DROIT ETAIT CELUI DU NAVIGATEUR. « Recharger », « Enregistrer
#     sous », « Inspecter » — la ou l'utilisateur cherchait « Epingler ».
#
# Constellation est desormais un client Wayland natif (s-constellation, QtQuick).
# Il n'y a plus de pont, plus de port, plus de moteur de rendu web dans la
# session. Le navigateur redevient ce qu'il aurait toujours du etre ici : une
# application parmi les autres.
#
# LE FILET RESTE, ET IL EST INCHANGE : une machine dont le bureau ne demarre pas
# est irreparable pour qui n'a pas de seconde machine. Si Constellation ne tient
# pas debout, cette coquille ne laisse pas un ecran noir : elle repose un bureau
# de secours et le dit. On perd l'apparence, jamais la machine.
set -uo pipefail

COQUILLE=/usr/bin/s-constellation
JOURNAL="${XDG_STATE_HOME:-$HOME/.local/state}/s"
mkdir -p "$JOURNAL"

dire() { printf 's-coquille : %s\n' "$*" >&2; }

# --------------------------------------------------------------------------
# DIRE A systemd QU'UNE SESSION GRAPHIQUE EXISTE — ce qui n'etait jamais fait
# --------------------------------------------------------------------------
# systemd tient une cible « graphical-session.target » a laquelle se rattache
# tout ce qui n'a de sens qu'avec un bureau ouvert. S ne la levait jamais.
#
# MESURE DU 2026-08-24, SUR LA MACHINE, DANS CETTE SESSION :
#   graphical-session.target  : inactive
#   xdg-desktop-portal        : « Dependency failed » — jamais demarre
#   plasma-dolphin.service    : echoue  (le gestionnaire de fichiers)
#   gvfs-*                    : jamais demarres
#   at-spi-dbus-bus           : jamais demarre
#   systemctl --user show-environment : AUCUNE variable de session
#
# LA CONSEQUENCE QUI A COUTE UNE SOIREE. Un programme Windows qui demande
# « ouvre cette page » passe par le portail XDG — c'est le seul chemin depuis
# le bac a sable de Proton, ou le /usr de l'hote n'est pas monte. Portail mort
# = rien ne s'ouvre, et sans le moindre message. C'est exactement ce que
# donnait un clic sur « Login » dans Cursor : rien.
#
# On importe d'abord les variables — le gestionnaire systemd de l'utilisateur
# demarre avant la session et n'en sait rien —, puis on leve la cible. Elle est
# posee ICI et non dans s-session parce que WAYLAND_DISPLAY n'existe qu'une
# fois le compositeur demarre, donc seulement dans ce processus-ci.
systemctl --user import-environment \
    WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE XDG_SESSION_DESKTOP \
    2>/dev/null || dire "les variables de session n'ont pas pu etre transmises a systemd"

# « graphical-session.target » refuse le demarrage manuel : elle ne se leve que
# TIREE par la cible d'une session. C'est le role de s-session.target, qui la
# porte en BindsTo — meme patron que plasma-workspace.target chez KDE.
if systemctl --user start s-session.target 2>/dev/null; then
    dire "session graphique declaree a systemd"
else
    dire "s-session.target n'a pas demarre — portail et gvfs resteront muets"
fi

# A la sortie, on redescend la cible : sans cela les services resteraient
# accroches a une session qui n'existe plus, et la connexion suivante les
# retrouverait dans un etat que personne n'a prevu.
fermer_session_systemd() {
    systemctl --user stop s-session.target 2>/dev/null || true
}
trap fermer_session_systemd EXIT

# --------------------------------------------------------------------------
# L'AGENT D'AUTHENTIFICATION — sans lui, tout geste systeme meurt sans un mot
# --------------------------------------------------------------------------
# MESURE DU 2026-08-25, DANS CETTE SESSION : aucun agent polkit ne tournait.
# Or « pkexec » n'ouvre pas de fenetre lui-meme : il demande a l'agent de la
# session de poser la question. Sans agent et sans terminal, il ne peut ni
# demander ni aboutir — s-android, s-monter-windows, s-grand-disque et
# s-nettoyer echouent alors tous de la meme facon, en silence.
#
# Plasma l'attachait a plasmashell, qui ne tourne plus ici. C'est donc a la
# coquille de S de le porter, comme elle porte deja graphical-session.target.
AGENT_POLKIT=/usr/libexec/kf6/polkit-kde-authentication-agent-1
if [[ -x "$AGENT_POLKIT" ]]; then
    "$AGENT_POLKIT" >>"$JOURNAL/polkit.log" 2>&1 &
    dire "agent d'authentification demarre"
else
    dire "aucun agent d'authentification — les gestes systeme ne pourront rien demander"
fi

# --------------------------------------------------------------------------
# LES REGLES kwin NE SE POSENT PLUS ICI
# --------------------------------------------------------------------------
# Elles y etaient le 2026-08-25 au matin, pour la bulle. Il en faut une seconde
# pour la barre des taches, et les deux dependent de la TAILLE DE L'ECRAN — que
# seul un programme connecte au compositeur connait. Constellation les pose donc
# elle-meme au demarrage, ou cette taille est deja sous la main.

lancer_coquille() {
    "$COQUILLE" >>"$JOURNAL/coquille.log" 2>&1
}

# --- Le filet --------------------------------------------------------------
# Trois chutes en moins d'une minute = ce n'est pas un accident, c'est une
# panne. On arrete de rejouer et on repose un bureau utilisable.
secours() {
    dire "Constellation ne tient pas — bureau de secours"
    # Detache et borne dans le temps, pour la meme raison qu'ailleurs : sans
    # demon de notifications, notify-send attend pour toujours — et c'est le
    # FILET qui resterait bloque, c'est-a-dire le seul morceau qui n'a pas le
    # droit de l'etre.
    if command -v notify-send >/dev/null 2>&1; then
        ( timeout 5 notify-send -u critical "S" \
            "Constellation n'a pas demarre. Bureau de secours ouvert. Le journal est dans ~/.local/state/s/." \
            >/dev/null 2>&1 & ) 2>/dev/null || true
    fi
    if command -v plasmashell >/dev/null 2>&1; then
        exec plasmashell
    elif command -v konsole >/dev/null 2>&1; then
        exec konsole
    else
        dire "aucun bureau de secours disponible"
        exec sleep infinity
    fi
}

if [[ ! -x "$COQUILLE" ]]; then
    dire "$COQUILLE absent ou non executable"
    secours
fi

chutes=0
depart=$SECONDS
while true; do
    lancer_coquille
    code=$?

    # UN BUREAU NE SE FERME PAS PAR ACCIDENT. La coquille est une fenetre ;
    # Alt+F4 la ferme proprement, code 0, et sans ce qui suit la session
    # s'arreterait la — l'utilisateur perdrait tout parce qu'il a manque un
    # raccourci. On ne s'arrete donc que si le temoin est pose, c'est-a-dire si
    # « Se deconnecter », « Redemarrer » ou « Eteindre » a ete choisi.
    if [[ -f "$JOURNAL/quitter" ]]; then
        rm -f "$JOURNAL/quitter"
        dire "sortie demandee par l'utilisateur"
        break
    fi
    if (( code == 0 )); then
        dire "coquille fermee sans demande de sortie — on la rouvre"
        continue
    fi

    (( SECONDS - depart > 60 )) && { chutes=0; depart=$SECONDS; }
    (( ++chutes >= 3 )) && secours
    dire "coquille tombee (code $code) — reprise $chutes/3"
    sleep 1
done
