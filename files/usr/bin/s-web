#!/usr/bin/bash
# S Web — le navigateur de S, sur le profil Vivaldi par defaut.
#
# DEMANDE DE L'UTILISATEUR (2026-10-23) : « S Web ouvre parfois des onglets et
# des favoris de sessions differentes ». MESURE sur la machine : deux profils
# Vivaldi tournaient en meme temps — le profil par defaut (~/.config/vivaldi),
# ou vivent les comptes Microsoft 365 / Google / MEWS connectes par RapidO,
# Gemini, Office et n8n (tous lances en « --app= », donc sur le profil defaut),
# et le profil separe S_WEB (~/.local/share/S/web) que ce script posait.
# Deux instances (~3,2 Go RSS cumule), memes fenetres indiscernables : c'etait
# ca, les « sessions differentes ».
#
# DECISION : S Web rejoint le profil par defaut. Un seul moteur (~1,6 Go
# rendus), les comptes deja connectes restent, et le blocage ne perd rien : la
# politique geree /etc/vivaldi/policies/managed/s-web.json (uBlock Origin Lite
# force, popups bloques, RestoreOnStartup=1) est une politique MACHINE, elle
# s'applique a tous les profils, pas seulement a S Web.
#
# Le moteur EST Vivaldi (deja dans l'image) : on ne reimplemente pas un
# bloqueur de pubs/traqueurs quand l'amont en maintient deja un vrai.

# LE VERROU NE SE NETTOIE JAMAIS SEUL SUR CETTE MACHINE.
#
# MESURE LE 2026-10-13 : en fermant Vivaldi PROPREMENT, « SingletonLock » reste
# en place ; au demarrage suivant, Chromium le trouve, voit que le PID nomme
# n'existe plus, et conclut a tort a un CRASH de la session precedente. On
# verifie donc soi-meme, avant de lancer, que le PID du verrou est bien vivant.
# Re-cible sur le profil par defaut depuis la fusion du 2026-10-23.
verrou="$HOME/.config/vivaldi/SingletonLock"
if [ -L "$verrou" ]; then
    cible="$(readlink "$verrou")"
    pid="${cible##*-}"
    if [ -n "$pid" ] && ! kill -0 "$pid" 2>/dev/null; then
        rm -f "$verrou" "$HOME/.config/vivaldi/SingletonCookie" "$HOME/.config/vivaldi/SingletonSocket"
    fi
fi

exec /usr/lib/opt/vivaldi/vivaldi --no-first-run "$@"
