#!/usr/bin/bash
# Le socle commun des coutures : chemins, verrou, et la facon de parler a
# l'utilisateur. Chaque « s-ouvrir-* » le charge par « source ».
#
# Regle qui tient tout le reste : une couture ne montre JAMAIS son moteur.
# Ce qui doit etre dit se dit par une notification de bureau, jamais par une
# fenetre de terminal ni par le programme tiers qui travaille en dessous.

S_DATA="${XDG_DATA_HOME:-$HOME/.local/share}/S"
S_PREFIXE="$S_DATA/windows"          # le prefixe Wine unique, vu comme « le Windows de S »
S_LANCEURS="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
S_ETAT="${XDG_STATE_HOME:-$HOME/.local/state}/S"

# Proton vit dans le dossier personnel, JAMAIS dans /usr : pressure-vessel, le
# bac a sable qu'umu utilise, reserve /usr et refuse de le partager dans son
# conteneur. Un Proton pose sous /usr y est litteralement introuvable.
# L'image porte l'archive ; s-ouvrir-exe la deplie ici au premier usage.
S_PROTON_ARCHIVE=/usr/lib/s/windows/proton.tar.gz
S_PROTON_RACINE="${XDG_DATA_HOME:-$HOME/.local/share}/Steam/compatibilitytools.d"

mkdir -p "$S_DATA" "$S_LANCEURS" "$S_ETAT"

# Une notification, avec un identifiant stable pour qu'un avancement remplace
# le precedent au lieu d'empiler les bulles.
s_dire() {
    local titre="$1" texte="${2:-}" icone="${3:-dialog-information}"
    command -v notify-send >/dev/null 2>&1 &&
        notify-send -a "S" -i "$icone" -h "string:x-canonical-private-synchronous:s-couture" \
            "$titre" "$texte" 2>/dev/null || true
    printf '%s — %s\n' "$titre" "$texte" >&2
}

s_echec() {
    s_dire "$1" "${2:-}" dialog-error
    exit 1
}

# Un verrou par monde : deux double-clics rapides ne doivent pas provisionner
# deux fois le meme environnement.
s_verrou() {
    local nom="$1"
    exec 9>"$S_ETAT/$nom.verrou"
    flock -w 600 9 || s_echec "S est deja occupe" "Une autre installation $nom est en cours."
}

# Rafraichit le menu pour que l'icone posee apparaisse sans attendre.
s_rafraichir_menu() {
    update-desktop-database "$S_LANCEURS" 2>/dev/null || true
}

# Faire monter une etoile au ciel de Constellation.
#
# POURQUOI CE N'EST PAS UN DETAIL. Depuis le 2026-08-23, le ciel ne montre que
# ce que l'utilisateur y a epingle — il le fallait, l'inventaire reel de la
# machine compte 81 entrees et les deverser toutes donnait un fouillis. Mais la
# regle a un effet de bord qu'il faut corriger ici : une application QU'ON VIENT
# D'INSTALLER n'apparaissait nulle part non plus. Or celle-la, l'utilisateur
# vient justement de dire qu'il la voulait — en l'installant.
#
# La distinction est donc : le ciel ne se remplit pas tout seul du passe, mais
# il accueille tout de suite ce qu'on y ajoute.
#
# On passe par le pont plutot que d'ecrire placees.json directement : c'est lui
# qui possede ce fichier, et deux ecrivains sur un meme fichier finissent
# toujours par se marcher dessus. S'il ne repond pas — session KDE de secours,
# bureau ferme — il n'y a rien a placer, et l'echec est sans consequence.
s_placer_etoile() {
    local ident="$1"
    local port="${S_ETOILES_PORT:-7373}"
    command -v curl >/dev/null 2>&1 || return 0
    # Une position pseudo-aleatoire mais STABLE pour un identifiant donne : deux
    # installations de suite ne posent pas deux etoiles au meme endroit, et
    # replacer la meme application la remet ou elle etait.
    local graine x y
    graine="$(printf '%s' "$ident" | cksum | cut -d' ' -f1)"
    x="0.$(( 20 + graine % 60 ))"
    y="0.$(( 20 + (graine / 60) % 55 ))"
    curl -fsS --max-time 3 -X POST \
         -H 'Content-Type: application/json' \
         -d "{\"id\":\"${ident}\",\"x\":${x},\"y\":${y}}" \
         "http://127.0.0.1:${port}/api/placer" >/dev/null 2>&1 || true
}
