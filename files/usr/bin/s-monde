#!/usr/bin/bash
# Le socle commun des coutures : chemins, verrou, et la facon de parler a
# l'utilisateur. Chaque « s-ouvrir-* » le charge par « source ».
#
# Regle qui tient tout le reste : une couture ne montre JAMAIS son moteur.
# Ce qui doit etre dit se dit par une notification de bureau, jamais par une
# fenetre de terminal ni par le programme tiers qui travaille en dessous.

S_DATA="${XDG_DATA_HOME:-$HOME/.local/share}/S"
S_PREFIXE="$S_DATA/windows"          # le prefixe Wine unique, vu comme « le Windows de S »
S_LANCEURS="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
S_ETAT="${XDG_STATE_HOME:-$HOME/.local/state}/S"
S_PARTAGE="$HOME/Partage"            # le dossier commun aux trois mondes

# Proton vit dans le dossier personnel, JAMAIS dans /usr : pressure-vessel, le
# bac a sable qu'umu utilise, reserve /usr et refuse de le partager dans son
# conteneur. Un Proton pose sous /usr y est litteralement introuvable.
# L'image porte l'archive ; s-ouvrir-exe la deplie ici au premier usage.
S_PROTON_ARCHIVE=/usr/lib/s/windows/proton.tar.gz
S_PROTON_RACINE="${XDG_DATA_HOME:-$HOME/.local/share}/Steam/compatibilitytools.d"

mkdir -p "$S_DATA" "$S_LANCEURS" "$S_ETAT"

# UN JOURNAL QUE L'UTILISATEUR NE PEUT PLUS ECRIRE CONDAMNE SON BLOC EN SILENCE.
#
# MESURE DU 2026-08-26, SUR LA MACHINE. « android-init.log » appartenait a root
# depuis le 25 aout a 10 h 42 — pose par un pkexec d'une version anterieure qui
# portait la redirection A L'INTERIEUR de l'elevation. Le dossier, lui, restait
# a l'utilisateur, donc rien ne paraissait anormal.
#
# CE QUE CA COUTAIT, ET C'EST LE POINT. Bash evalue une redirection AVANT de
# lancer la commande. Une redirection refusee fait donc echouer la ligne
# ENTIERE sans que la commande ait tourne une seule fois — et « || true »
# l'avale. Mesure :
#
#   /usr/bin/touch /tmp/temoin >> <journal non inscriptible>
#   code de retour : 1     ->  la commande N'A JAMAIS TOURNE
#
# Pendant vingt-huit heures, « waydroid upgrade -o » et le reglage de mise en
# veille d'Android n'ont donc jamais tourne, pendant que le geste affichait
# « Application des reglages a Android… ». La densite est restee a 180 et le
# carnet croyait ces deux reglages poses.
#
# On repare a l'ouverture, pour TOUS les journaux d'un coup — dix-neuf lignes
# du depot ecrivent sous $S_ETAT, et n'importe laquelle peut etre condamnee de
# la meme facon. Et on repare le legs plutot que les seules installations
# neuves : une correction qui ne rattrape pas les machines existantes n'en est
# pas une. L'ancien journal est garde a cote, jamais efface.
for _s_j in "$S_ETAT"/*.log; do
    [ -e "$_s_j" ] || continue
    [ -w "$_s_j" ] && continue
    mv -f "$_s_j" "$_s_j.non-inscriptible" 2>/dev/null && : > "$_s_j" 2>/dev/null
done
unset _s_j

# UN PROCESSUS PRIVILEGIE NE DOIT JAMAIS RECEVOIR LE DESCRIPTEUR DU JOURNAL.
#
# TROUVE LE 2026-08-26, EN CHERCHANT POURQUOI UN JOURNAL REPARE REDEVENAIT ROOT
# QUATRE MINUTES PLUS TARD. Le coupable n'est pas S : c'est « lxc-attach », que
# « waydroid shell » appelle. Il chowne SON PROPRE stdout pour le donner au
# processus qui tourne dans le conteneur — et quand ce stdout est un fichier
# redirige, c'est le FICHIER qui change de proprietaire.
#
# waydroid le sait a moitie : tools/helpers/lxc.py releve le mode avant et le
# repose apres (« os.chmod(sys.stdout.fileno(), perms) »). Il repose le MODE,
# jamais le PROPRIETAIRE. Le journal reste donc a root.
#
# Consequence, mesuree : dans un meme lancement, le bloc de mise en veille
# faisait passer android-init.log a root, et l'appel « appops » vingt lignes
# plus bas mourait sur sa redirection sans avoir tourne.
#
# On donne donc un TUYAU au processus privilegie, jamais le fichier. « tee »
# est lance par le shell de l'utilisateur : c'est lui qui tient le journal, et
# rien de ce qui se passe en root ne peut l'atteindre. « pipefail » etant arme
# dans chaque geste, le code de retour de la commande est preserve.
s_tee() { tee -a "$1" >/dev/null; }

# Une notification, avec un identifiant stable pour qu'un avancement remplace
# le precedent au lieu d'empiler les bulles.
s_dire() {
    local titre="$1" texte="${2:-}" icone="${3:-dialog-information}"
    # UNE PHRASE NE DOIT JAMAIS RETENIR LE GESTE QUI LA DIT.
    #
    # MESURE DU 2026-08-25, DANS LA SESSION S, SUR LA MACHINE : s-android est
    # reste bloque sur sa toute premiere phrase, indefiniment, sans un mot.
    # « org.freedesktop.Notifications » est declare activable par
    # /usr/share/dbus-1/services/org.kde.plasma.Notifications.service, dont
    # l'Exec est « plasma_waitforname org.freedesktop.Notifications » : il
    # ATTEND que quelqu'un publie ce nom, et le seul qui le publie est
    # plasmashell — qui ne tourne pas ici, puisque la coquille est Constellation.
    # notify-send attend donc pour toujours une reponse qui ne viendra jamais.
    #
    # C'est la panne la plus large que ce carnet ait rencontree : elle ne visait
    # pas Android, elle gelait TOUTE couture des sa premiere notification.
    #
    # Deux protections, parce qu'une seule ne suffit pas : la bulle part en
    # arriere-plan detachee — le geste continue quoi qu'il arrive — et « timeout »
    # l'empeche de vivre plus de cinq secondes si personne ne repond.
    if command -v notify-send >/dev/null 2>&1; then
        ( timeout 5 notify-send -a "S" -i "$icone" \
            -h "string:x-canonical-private-synchronous:s-couture" \
            "$titre" "$texte" >/dev/null 2>&1 & ) 2>/dev/null || true
    fi
    printf '%s — %s\n' "$titre" "$texte" >&2
}

s_echec() {
    s_dire "$1" "${2:-}" dialog-error
    exit 1
}

# ---------------------------------------------------------------------------
# s_root — une elevation qui ne peut pas figer le geste
# ---------------------------------------------------------------------------
# CE QUE CA REPARE, MESURE LE 2026-08-26 AU MATIN.
#
# s-android a ete lance pendant que l'utilisateur etait AILLEURS. Il s'est
# arrete sur « pkexec /usr/bin/python3 » — le reglage de l'affichage Android —
# et il y est reste TROIS MINUTES, jusqu'a ce qu'on le tue. Sans limite, il y
# serait encore : pkexec attend une authentification qui ne viendra pas, et
# l'agent polkit garde une fenetre ouverte sur un ecran que personne ne
# regarde. Le geste ne rend jamais la main, le verrou du monde reste pris, et
# rien ne le dit.
#
# Ce n'est pas propre a Android : NEUF appels a pkexec dans quatre gestes
# avaient exactement la meme faille. C'est donc ici qu'on la ferme, une fois.
#
# « --foreground » N'EST PAS DECORATIF. Sans lui, timeout place le programme
# dans un autre groupe de processus ; le jour ou pkexec n'a pas d'agent
# graphique et retombe sur sa demande en clair dans un terminal, la lecture du
# terminal leverait SIGTTIN et l'arreterait. On garde le premier plan.
#
# ET ON NE REMPLACE PAS L'ECHEC PAR UN SILENCE : un depassement se dit, avec le
# nom de ce qui n'a pas ete fait. L'appelant decide s'il continue degrade ou
# s'il s'arrete — les deux sont legitimes, se taire ne l'est pas.
#
#   s_root <commande...>                    limite par defaut : 120 s
#   s_root --limite 900 <commande...>       pour un travail legitimement long
#
# Rend le code de la commande, ou 124 si la limite a ete atteinte.
s_root() {
    local limite=120
    if [ "${1:-}" = "--limite" ]; then limite="$2"; shift 2; fi
    local quoi="$1"
    timeout --foreground "$limite" pkexec "$@"
    local code=$?
    if [ "$code" = 124 ]; then
        s_dire "Autorisation non donnee" \
"« $quoi » demandait un mot de passe et personne n'a repondu en ${limite} s. \
Le geste continue sans cette etape." dialog-warning
    fi
    return $code
}

# Un verrou par monde : deux double-clics rapides ne doivent pas provisionner
# deux fois le meme environnement.
s_verrou() {
    local nom="$1"
    exec 9>"$S_ETAT/$nom.verrou"
    flock -w 600 9 || s_echec "S est deja occupe" "Une autre installation $nom est en cours."
}

# Rafraichit le menu pour que l'icone posee apparaisse sans attendre.
s_rafraichir_menu() {
    update-desktop-database "$S_LANCEURS" 2>/dev/null || true
}

# Faire monter une etoile au ciel de Constellation.
#
# POURQUOI CE N'EST PAS UN DETAIL. Depuis le 2026-08-23, le ciel ne montre que
# ce que l'utilisateur y a epingle — il le fallait, l'inventaire reel de la
# machine compte 81 entrees et les deverser toutes donnait un fouillis. Mais la
# regle a un effet de bord qu'il faut corriger ici : une application QU'ON VIENT
# D'INSTALLER n'apparaissait nulle part non plus. Or celle-la, l'utilisateur
# vient justement de dire qu'il la voulait — en l'installant.
#
# La distinction est donc : le ciel ne se remplit pas tout seul du passe, mais
# il accueille tout de suite ce qu'on y ajoute.
#
# ON N'APPELLE PLUS DE PONT : IL N'Y EN A PLUS. Jusqu'au 2026-08-24 cette
# fonction postait sur http://127.0.0.1:7373/api/placer, parce que le bureau
# etait une page web et que le serveur qui la servait possedait placees.json.
# Constellation etant devenue un client natif, ce serveur n'existe plus.
#
# On ecrit donc par le noyau, qui est desormais le seul proprietaire du
# fichier — et qui le remplace d'un seul geste (ecriture dans un temporaire
# puis os.replace). Deux ecrivains simultanes ne peuvent donc PAS corrompre le
# fichier ; au pire l'un des deux ajouts est perdu, ce qui se rattrape d'un
# glisser-deposer. C'est un compromis assume, et il est meilleur que l'ancien :
# avant, si le bureau n'etait pas ouvert, le placement etait perdu a coup sur.
s_placer_etoile() {
    local ident="$1"
    command -v python3 >/dev/null 2>&1 || return 0
    # Une position pseudo-aleatoire mais STABLE pour un identifiant donne : deux
    # installations de suite ne posent pas deux etoiles au meme endroit, et
    # replacer la meme application la remet ou elle etait.
    local graine x y
    graine="$(printf '%s' "$ident" | cksum | cut -d' ' -f1)"
    x="0.$(( 20 + graine % 60 ))"
    y="0.$(( 20 + (graine / 60) % 55 ))"
    python3 - "$ident" "$x" "$y" <<'PY' 2>/dev/null || true
import sys
sys.path.insert(0, "/usr/lib/s")
import noyau
placees = noyau.charger_placees()
placees[sys.argv[1]] = {"x": float(sys.argv[2]), "y": float(sys.argv[3])}
noyau.sauver_placees(placees)
PY
}

# OU EST LE /sdcard DE WAYDROID, VU DE LINUX.
#
# Il n'y a pas UN chemin : Waydroid le lit dans sa propre configuration, et il
# differe entre une installation systeme et une installation par utilisateur.
# On le demande donc a waydroid.cfg plutot que de le deviner — deviner un
# chemin est la faute que le carnet nomme le plus souvent dans ce depot.
# LA DECOUVERTE DU /sdcard VIT DANS SON PROPRE FICHIER, ET C'EST UNE LECON.
# Elle etait ici ET dans le mode root de s-partage. Corrigee d'un cote le
# 2026-08-25 et pas de l'autre, elle a fait repondre au geste « Waydroid pas
# encore initialise » a la seconde ou le service venait de poser le montage.
# LA BIBLIOTHEQUE VIT DANS /usr/lib/s. On accepte aussi une copie de travail a
# cote de ce fichier — meme convention que s-constellation, et pour la meme
# raison : c'est la seule facon d'essayer un geste sans reconstruire une image
# de plusieurs gigaoctets.
_s_ici="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
for _s_lib in "${S_LIB:-}" /usr/lib/s "$_s_ici/../lib/s"; do
    if [ -n "$_s_lib" ] && [ -f "$_s_lib/partage-android.sh" ]; then
        source "$_s_lib/partage-android.sh"
        # Le dossier trouve est GARDE : d'autres gestes que celui-ci en ont
        # besoin — s-android y lit « regles-kwin.py » pour dimensionner la
        # fenetre Android avec la meme formule que la coquille emploie pour la
        # centrer. Refaire la recherche ailleurs serait une seconde source.
        S_LIB="$_s_lib"
        break
    fi
done
unset _s_ici _s_lib

# L'ancien nom continue de repondre : une couture hors de ce depot pourrait
# l'appeler, et la casser en silence serait exactement ce qu'on essaie d'eviter.
s_partage_media_android() { s_android_media "$@"; }
