#!/usr/bin/bash
# Double-clic sur un .exe ou un .msi : ca s'installe, ou ca se lance.
# Aucune fenetre de Lutris, de Bottles ou de Steam n'apparait : umu-run pose
# Proton en dessous et rend la main au programme Windows lui-meme.
set -uo pipefail
source /usr/bin/s-monde

CIBLE="${1:-}"
[ -n "$CIBLE" ] || s_echec "Rien a ouvrir" "s-ouvrir-exe attend un chemin de fichier."
CIBLE="$(readlink -f "$CIBLE")"
[ -f "$CIBLE" ] || s_echec "Fichier introuvable" "$CIBLE"

export WINEPREFIX="$S_PREFIXE"
export GAMEID="${GAMEID:-umu-0}"
export UMU_LOG="${UMU_LOG:-warn}"
NOM="$(basename "$CIBLE")"

s_verrou windows

# --- Premiere utilisation : le Windows de S n'existe pas encore -------------
# L'archive de Proton est dans l'image : la deplier localement evite les
# 468 Mo de telechargement qu'umu ferait sinon, et le reseau disparait du
# chemin critique. La version deja depliee est reutilisee telle quelle.
if [ -f "$S_PROTON_ARCHIVE" ]; then
    VERSION="$(cat /usr/lib/s/windows/proton.version 2>/dev/null || echo inconnue)"
    if [ ! -d "$S_PROTON_RACINE/$VERSION" ]; then
        s_dire "Premiere utilisation" "Preparation de Proton depuis l'image, sans telechargement."
        mkdir -p "$S_PROTON_RACINE"
        tar xzf "$S_PROTON_ARCHIVE" -C "$S_PROTON_RACINE" || \
            s_dire "Proton n'a pas pu etre deplie" "umu le telechargera lui-meme." dialog-warning
    fi
    [ -d "$S_PROTON_RACINE/$VERSION" ] && export PROTONPATH="$S_PROTON_RACINE/$VERSION"
fi

if [ ! -d "$WINEPREFIX/drive_c" ]; then
    if [ -n "${PROTONPATH:-}" ]; then
        s_dire "Premiere utilisation" "Preparation de l'environnement Windows, une minute."
    else
        s_dire "Premiere utilisation" "Telechargement de Proton, puis preparation. Quelques minutes."
    fi
    mkdir -p "$WINEPREFIX"
    if ! umu-run wineboot -u >"$S_ETAT/windows-init.log" 2>&1; then
        s_echec "L'environnement Windows n'a pas pu etre prepare" \
                "Detail dans $S_ETAT/windows-init.log"
    fi
fi

# --- Lancer ----------------------------------------------------------------
s_dire "$NOM" "Ouverture…" application-x-executable

case "${CIBLE,,}" in
    *.msi) umu-run "$WINEPREFIX/drive_c/windows/system32/msiexec.exe" /i "$CIBLE" ;;
    *)     umu-run "$CIBLE" ;;
esac
CODE=$?

# --- Attendre que Wine ait FINI d'ecrire ------------------------------------
# CE QUI ETAIT FAUX AVANT, et que seul un vrai installateur pouvait montrer :
# on photographiait le menu juste avant, puis juste apres le retour d'umu-run,
# et on ne moissonnait que si la difference etait non nulle. Or umu-run rend la
# main des que le PROCESSUS PRINCIPAL sort, tandis que winemenubuilder tourne a
# cote et que l'installateur Windows ecrit ses raccourcis dans ses dernieres
# secondes. La comparaison se faisait donc regulierement trop tot — et comme
# elle conditionnait la moisson, il n'y avait aucun rattrapage : ni minuterie,
# ni second passage, ni message. VLC installe le 2026-08-23 n'est apparu nulle
# part pour cette raison, entre autres.
#
# « wineserver -w » attend que TOUS les processus du prefixe soient sortis.
# C'est la primitive faite pour ca, et elle rend la main tout de suite quand il
# n'y a plus rien a attendre.
umu-run wineserver -w >/dev/null 2>&1 || true

# --- Moisonner, DANS TOUS LES CAS ------------------------------------------
# Sans cette etape, les icones de Wine existent mais ne lancent RIEN :
# winemenubuilder les ecrit avec « Exec=… wine … », et « wine » n'est pas sur
# ce systeme. Et on l'appelle meme quand rien n'a l'air d'avoir bouge : lui
# seul sait lire les .lnk du prefixe, et le cas ou winemenubuilder n'a rien
# ecrit du tout est precisement celui qui nous echappait.
LU="$(s-menu-windows --silencieux 2>/dev/null | tail -n1)"
read -r _POSES NEUFS _IGNORES <<<"${LU:-0 0 0}"
NEUFS="${NEUFS:-0}"

# --- Dire ce qui s'est passe. Toujours. -------------------------------------
if [ "$CODE" -ne 0 ]; then
    s_dire "$NOM" "S'est termine sur une erreur (code $CODE)." dialog-warning
elif [ "$NEUFS" -gt 0 ]; then
    s_dire "$NOM" "Installe. $NEUFS programme(s) ajoute(s) au menu et au ciel." \
           application-x-executable
else
    # Rien de neuf. Deux lectures possibles, et une seule merite un
    # avertissement : relancer un programme deja installe est normal, une
    # INSTALLATION qui ne produit aucun raccourci ne l'est pas.
    case "${NOM,,}" in
        *setup*|*install*|*.msi)
            s_dire "$NOM" \
"Termine, mais aucun raccourci n'a ete trouve. Le programme est peut-etre \
installe sans entree de menu — chercher dans le dossier Windows de S." \
                   dialog-warning ;;
        *)
            s_dire "$NOM" "Termine." application-x-executable ;;
    esac
fi
exit "$CODE"
