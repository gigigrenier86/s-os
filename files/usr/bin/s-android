#!/usr/bin/bash
# Le monde Android de S : une seule icone qui fait tout.
#
# Android EST Linux, et son espace utilisateur tourne dans un conteneur sur le
# noyau de la machine — non plus par l'outillage Python de Waydroid depuis le
# 2026-08-28 (voir CLAUDE.md), mais par lxc-start direct (s-android.service,
# android-lancer.sh). Ce script reste la seule icone qui fait tout : demarrer
# le conteneur, poser les proprietes d'affichage, ouvrir une application.
set -uo pipefail
source /usr/bin/s-monde

MARQUE="$S_ETAT/android-pret"
APK_MAISON=/usr/share/s/apk

s_verrou android

# --- Premiere utilisation : IL N'Y A PLUS DE TELECHARGEMENT -----------------
#
# CE BLOC FAISAIT « waydroid init -s GAPPS -c ... -v ... » — le seul chemin
# qui ait jamais pose system.img/vendor.img sur une machine neuve. Le paquet
# waydroid, et son initialiseur Python, sont partis avec lui le 2026-08-29 :
# IL N'EXISTE PLUS AUCUN MOYEN NATIF DE TELECHARGER ANDROID.
#
# CETTE MACHINE-CI a deja ses images (residu du 2026-08-25, pose avant le
# retrait) — le geste marche donc ICI. Une machine reconstruite a neuf n'aurait
# ni system.img ni vendor.img, et rien dans ce depot ne saurait plus les poser
# : il faudrait reproduire la logique OTA de l'ancien initializer.py (deux URL
# JSON, extraction). NON COMMENCE, chantier a part — voir CLAUDE.md,
# 2026-08-29.
#
# On verifie donc que ce qu'il faut est bien la, et on le DIT honnetement si ce
# n'est pas le cas plutot que de pretendre pouvoir le reparer.
if [ ! -f /var/lib/waydroid/images/system.img ] || \
   [ ! -f /var/lib/waydroid/images/vendor.img ]; then
    s_echec "Android n'est pas prepare sur cette machine" \
"system.img ou vendor.img manque dans /var/lib/waydroid/images, et S ne sait \
plus les telecharger depuis le retrait de Waydroid — voir CLAUDE.md, \
2026-08-29."
fi

# --- Android en FENETRES — ET LE MODE A CHANGE LE 2026-08-25 AU SOIR --------
#
# CE QUE CE BLOC DISAIT AVANT, ET QUI ETAIT VRAI A MOITIE. Il posait
# « multi_windows = true » et expliquait que sans lui, Waydroid rend une seule
# surface plein ecran ou vit tout Android. C'est vrai du mode « full_ui », et
# c'est faux du mode qu'on emploie desormais.
#
# CE QUE MULTI_WINDOWS COUTAIT, MESURE SUR LA MACHINE. Une video jouee dans une
# application Android laissait un TROU : on voyait le bureau au travers. Pas un
# ecran noir — rien. Le son marchait, la barre de progression avancait, les
# sous-titres s'affichaient PAR-DESSUS le vide. Seule la surface video manquait.
#
# LA CAUSE, LUE DANS LA TABLE DES SYMBOLES DE hwcomposer.waydroid.so :
#
#     compositing_full_ui_mode        / non_compositing_full_ui_mode
#     compositing_single_window_mode  / non_compositing_single_window_mode
#     multi_window_mode               <- SEUL, sans variante « compositing »
#
# « full_ui » et « single_window » ont chacun une variante qui COMPOSE les
# couches d'Android ensemble avant de les rendre. « multi_window_mode » n'en a
# pas : il ne sait que faire correspondre UNE couche a UNE fenetre — d'ou son
# « can_handle_layer() », et d'ou la couche video qui n'a nulle part ou aller.
#
# Ce n'est donc pas un bogue de Waydroid : c'est une capacite que ce mode n'a
# jamais eue. Le releve de SurfaceFlinger le montrait sans qu'on sache le lire :
#
#     TID:23#…/HomeActivity#115      DEVICE  1920x1028   <- la fenetre, posee
#          …/HomeActivity(BLAST)#126 DEVICE  1280x714    <- la video, perdue
#
# CE QU'ON EMPLOIE A LA PLACE. « multi_windows = false » AVEC un lancement
# par paquet (« waydroid app launch » alors, « s_android_lancer » depuis le
# 2026-08-29) ne donne PAS le plein ecran d'Android : il
# donne « compositing_single_window_mode » — une fenetre qui ne montre que
# l'application, sans barre d'etat, sans barre de navigation, sans lanceur, et
# dont le compositeur assemble lui-meme toutes les couches. La video y est.
#
# C'est la regle 9 du projet appliquee jusqu'au bout : une couture ne montre
# jamais son moteur. Une icone, un clic, l'application — et rien d'Android.
#
# CE QUE CA COUTE, ET IL FAUT LE DIRE. Waydroid ne tient qu'UNE fenetre Android
# a la fois dans ce mode : ouvrir Gmail pendant que YouTube tourne remplace la
# fenetre au lieu d'en ajouter une. C'est le prix, il est connu, et il vaut
# mieux qu'une video invisible.
#
# CINQ HYPOTHESES ONT ETE REFUTEES AVANT CELLE-CI, toutes par la mesure : les
# codecs (27 decodeurs OMX presents), le plein ecran de l'application
# (identique), le masquage reseau (la regle existe et compte ses paquets),
# « use_subsurface » dans les deux sens (les couches restent DEVICE), et forcer
# la composition GPU par SurfaceFlinger (plus AUCUNE fenetre Android — ce qui a
# d'ailleurs livre le mecanisme : le compositeur fabrique les fenetres A PARTIR
# des couches DEVICE). Aucune n'est entree dans le depot.
#
# LA PROPRIETE SE POSE AVANT LE DEMARRAGE DU CONTENEUR, PAS APRES : elle est
# lue quand il monte. Posee a chaud, elle ne prend qu'au prochain demarrage, et
# l'utilisateur conclurait qu'elle ne marche pas.
#
# CE QUI A CHANGE LE 2026-08-29 : IL N'Y A PLUS QU'UN SEUL FICHIER A LIRE. Ce
# bloc devait avant interroger Android EN MARCHE (« waydroid prop get ») parce
# que waydroid.cfg pouvait mentir — sa section [properties] n'etait versee
# dans le conteneur que par « waydroid upgrade -o », un pas facile a oublier,
# et le carnet du 2026-08-25 a paye cette confusion en toutes lettres
# (« waydroid.cfg disait 140, waydroid prop get disait 180 »). Ce piege
# n'existe plus : il n'y a plus de waydroid.cfg du tout, et android-lancer.sh
# bind-monte directement /var/lib/waydroid/waydroid.prop dans le conteneur a
# CHAQUE demarrage — le lire (s_android_prop_lire) dit exactement ce qui sera
# applique au prochain demarrage, sans plus jamais avoir besoin de demander a
# Android lui-meme.
#
#   ro.sf.lcd_density = 140 — la valeur livree est 180, pensee pour un ecran de
#   telephone tenu a trente centimetres. Sur un 1920x1080 de bureau, tout est
#   demesure : Android croit avoir 1707 points de large la ou il en a 1920. A
#   140, il en compte 2194 et l'interface redevient celle d'un ecran, pas d'une
#   loupe.
#
# LE GARDE PORTE SUR CHAQUE REGLAGE, PAS SUR UN SEUL. Une machine qui a recu
# le premier avant que les autres n'existent doit encore les recevoir ; sinon
# le correctif ne rattrape que les installations neuves, ce qui est exactement
# la faute que ce carnet reproche aux marqueurs de premier demarrage.
#
# « suspend_action = none » a disparu de ce script : c'etait un reglage
# [waydroid] de waydroid.cfg (pas une propriete Android), et le carnet du
# 2026-08-25 avait deja mesure qu'il NE FAISAIT RIEN — aucun des deux
# comportements que l'amont implementait (« stop » ou geler) n'etait celui
# qu'on voulait. Rien de ce mecanisme n'existe plus cote natif ; ne pas le
# recreer n'est donc pas une regression, juste l'abandon d'un reglage qui
# n'avait jamais eu d'effet.
# --- LA TAILLE DE LA FENETRE ANDROID, ET POURQUOI ELLE NE PEUT PAS ETRE PLEINE
#
# TROUVE LE 2026-08-26, A L'ECRAN, EN REGARDANT YOUTUBE. Son ecran d'accueil
# servait UNE colonne : une vignette large de 1920 px par ligne. L'utilisateur :
# « dans le menu de base, tout est trop gros ».
#
# DEUX HYPOTHESES SONT MORTES AVANT LA BONNE, et les ecrire ferme les pistes :
#
#   la densite            REFUTEE. Une vignette a 100 % de large fait 1920 px
#                         que la densite soit 140 ou 240 : la densite ne change
#                         que le texte et les icones, jamais la mise en page.
#   characteristics=tablet  REFUTEE. Posee, verifiee (« getprop » rend bien
#                         « tablet »), et YouTube n'en a tenu aucun compte.
#
# CE QUI DECIDE EST LE QUALIFICATEUR « long » D'ANDROID. AOSP classe un ecran
# dont le rapport long/court atteint 1,75 comme LONG — c'est-a-dire un telephone
# en paysage — et YouTube lui sert sa mise en page telephone. Mesure, en isolant
# la variable : a 1943 dp de large (donc presque aussi large qu'avant) mais
# « notlong », l'accueil passe a TROIS colonnes.
#
#   1920 x 1028  ->  rapport 1,868  ->  xlarge-long-     ->  une colonne
#   1700 x 1028  ->  rapport 1,654  ->  xlarge-notlong-  ->  trois colonnes
#
# On calcule donc la largeur au lieu de la coder en dur — 1700 ne vaut que pour
# un ecran 1920x1080, et S doit demarrer ailleurs. La hauteur retire la barre de
# S, ce qui a un second effet mesure : la fenetre Android cesse de couvrir les
# 52 derniers pixels, defaut que ce carnet portait depuis le 2026-08-25.
#
# Le rapport vise est 1,70 et non 1,74 : le seuil d'AOSP est un flottant, et on
# ne se pose pas a un centieme d'une bascule qu'on ne controle pas.
S_ECRAN_MODE=""
for _m in /sys/class/drm/card*-*/modes; do
    [ -s "$_m" ] || continue
    S_ECRAN_MODE="$(head -1 "$_m" 2>/dev/null)"
    [ -n "$S_ECRAN_MODE" ] && break
done
S_FEN_L=""; S_FEN_H=""
case "$S_ECRAN_MODE" in
    [0-9]*x[0-9]*)
        # LA FORMULE N'EST PAS ICI, ET C'EST VOULU. Elle vit dans
        # regles-kwin.py, ou la coquille la lit pour CENTRER cette meme
        # fenetre. Deux formules qui doivent rester d'accord finissent par
        # diverger — ce depot l'a paye sur s-partage, sur les roles, et sur
        # s-session.target.
        read -r S_FEN_L S_FEN_H < <(
            /usr/bin/python3 - "${S_LIB:-/usr/lib/s}" \
                "${S_ECRAN_MODE%%x*}" "${S_ECRAN_MODE##*x}" <<'PY' 2>/dev/null || true
import importlib.util, os, sys
lib, larg, haut = sys.argv[1], int(sys.argv[2]), int(sys.argv[3])
spec = importlib.util.spec_from_file_location(
    "regles_kwin", os.path.join(lib, "regles-kwin.py"))
mod = importlib.util.module_from_spec(spec)
spec.loader.exec_module(mod)
print("%d %d" % mod.taille_android(larg, haut))
PY
        )
        ;;
esac
# Si on ne sait pas lire l'ecran, on ne devine pas : le fichier de proprietes
# garde ses valeurs actuelles plutot qu'une fenetre calculee sur une
# supposition.

# TOUTES LES PROPRIETES DE DEMARRAGE SE LISENT DANS LE MEME FICHIER
# MAINTENANT — densite, mode fenetre, taille ET use_subsurface (voir plus
# bas) sont verifiees ici d'un coup, plutot qu'en trois passes separees
# comme avant. Une seule ecriture, un seul mot de passe si quelque chose
# manque.
manque=0
[ "$(s_android_prop_lire ro.sf.lcd_density)" = "140" ] || manque=1
[ "$(s_android_prop_lire persist.waydroid.multi_windows)" = "false" ] || manque=1
[ "$(s_android_prop_lire persist.waydroid.use_subsurface)" = "false" ] || manque=1
if [ -n "$S_FEN_L" ]; then
    [ "$(s_android_prop_lire persist.waydroid.width)" = "$S_FEN_L" ] || manque=1
    [ "$(s_android_prop_lire persist.waydroid.height)" = "$S_FEN_H" ] || manque=1
fi
if [ "$manque" = 1 ]; then
    s_dire "Android" "Reglage de l'affichage — un mot de passe va etre demande, une seule fois." phone
    ANDROID_ETAIT_LA="$(s_android_etat)"
    if [ -n "$S_FEN_L" ]; then
        s_android_prop_ecrire \
            "ro.sf.lcd_density=140" \
            "persist.waydroid.multi_windows=false" \
            "persist.waydroid.use_subsurface=false" \
            "persist.waydroid.width=$S_FEN_L" \
            "persist.waydroid.height=$S_FEN_H"
    else
        s_android_prop_ecrire \
            "ro.sf.lcd_density=140" \
            "persist.waydroid.multi_windows=false" \
            "persist.waydroid.use_subsurface=false"
    fi
    # NE PREND EFFET QU'AU PROCHAIN DEMARRAGE DU CONTENEUR : on ne redemarre
    # que s'il tournait deja (sinon la section suivante le demarrera avec le
    # fichier deja a jour, un seul redemarrage au lieu de deux).
    if [ "$ANDROID_ETAIT_LA" = "RUNNING" ]; then
        s_dire "Android" "Redemarrage pour appliquer les reglages…" phone
        s_root systemctl restart s-android.service
    fi
fi

# --- Demarrer le conteneur, si il ne tourne pas ------------------------------
#
# PLUS DE VERROU A FERMER APRES COUP : l'ancien piege (« waydroid session
# start » vivait en arriere-plan et son enfant heritait du descripteur du
# verrou du monde, le gardant pris tant qu'Android tournait) n'existe plus
# ici. « systemctl start » rend la main des que le service est lance ;
# s-android.service lui-meme, pas ce script, porte lxc-start — rien de ce
# geste ne reste attache au verrou de « s_verrou android » au-dela de la
# duree normale de CE script.
#
# DEMARRER ET ATTENDRE QU'ANDROID SOIT PRET, DANS UNE SEULE ELEVATION.
#
# LA COURSE, MESUREE LE 2026-08-29 SUR LA MACHINE FRAICHEMENT REDEMARREE :
# conteneur lance a 14:29:33, « pm list packages » a 14:29:36 — trois
# secondes plus tard, avant que le gestionnaire de paquets d'Android
# n'existe (« cmd: Can't find service: package » au journal). Le geste a
# conclu « F-Droid absent », tente une reinstallation trop tot elle aussi,
# et ecrit son marqueur quand meme. « RUNNING » cote lxc veut dire « /init
# a demarre », pas « Android est utilisable » ; le seul temoin fiable est
# « sys.boot_completed », qui ne se lit que dans le conteneur, donc en root.
#
# On le lit donc dans LA MEME elevation que le demarrage : un seul mot de
# passe pour les deux, et tout ce qui suit (pm, settings, appops, am start)
# trouve un Android qui repond.
if [ "$(s_android_etat)" != "RUNNING" ]; then
    s_dire "Android" "Demarrage…" phone
    s_root --limite 240 /usr/bin/sh -c '
        systemctl start s-android.service || exit 1
        for _ in $(seq 1 100); do
            pret="$(lxc-attach -P /var/lib/waydroid/lxc -n android -- \
                    getprop sys.boot_completed 2>/dev/null | tr -d "\r")"
            [ "$pret" = "1" ] && exit 0
            sleep 2
        done
        exit 2
    '
    case $? in
        0) ;;
        2) s_dire "Android" \
"Le conteneur tourne mais Android n'a pas annonce la fin de son demarrage \
en 200 s. La suite peut echouer." dialog-warning ;;
        *) : ;;   # echec du start : la verification ci-dessous le dira
    esac
fi

[ "$(s_android_etat)" = "RUNNING" ] || \
    s_echec "Android n'a pas demarre" "Voir : sudo journalctl -u s-android.service"

# --- EMPECHER ANDROID DE S'ENDORMIR ----------------------------------------
#
# LE DEFAUT, MESURE LE 2026-08-25 AU SOIR, ET IL NE RESSEMBLAIT PAS A CA.
# L'utilisateur a rapporte « aucune connexion internet » dans les applications
# Android, alors que l'hote avait internet et que le masquage reseau comptait
# ses paquets. Releve dans le conteneur :
#
#     ip route          → 192.168.240.0/24 dev eth0 ... et RIEN d'autre
#     getprop net.dns1  → (vide)
#     ping 8.8.8.8      → Network is unreachable
#
# Android avait son adresse et aucun moyen de sortir de son sous-reseau.
#
# LA CAUSE, LUE DANS waydroid.log :
#     17:55:52  lxc-freeze → FROZEN
#     17:58:32  FROZEN → lxc-unfreeze
# et pendant ce temps le compteur du pont waydroid0 fige a RX = 8862 paquets.
#
# Un conteneur gele, ce sont TOUS ses processus arretes : plus de pile reseau,
# plus d'ARP, plus de bail DHCP. Au degel, Android ne recupere ni sa route par
# defaut ni son DNS. Le gel ne casse donc pas que l'affichage — il casse le
# reseau, durablement, et rien ne le dit.
#
# ON NE PEUT PAS REFUSER LE GEL. « suspend_action » n'a que deux comportements
# dans waydroid 1.6.3 : « stop », qui arrete la session entiere, ou geler. La
# valeur « none » n'existe pas (voir le bloc des reglages plus haut).
#
# LE LEVIER EST DE L'AUTRE COTE. Le gel n'est pas decide par Waydroid : Android
# le DEMANDE, en appelant suspend() sur IHardware quand il eteint son ecran.
# Un ecran qui ne s'eteint jamais ne demande jamais rien. C'est une politique
# d'economie d'energie pensee pour un telephone dans une poche, appliquee a une
# fenetre de bureau — la meme famille que la densite de 180.
#
# MESURE SUR LA MACHINE : 25 gels dans la journee, le dernier a 17 h 55, AUCUN
# apres avoir pose ces deux reglages.
#
# Le garde interroge Android, jamais un fichier — la lecon de la journee.
# LE GARDE NE PEUT PAS INTERROGER ANDROID ICI, ET IL FAUT LE DIRE.
# « lxc-attach » exige les droits d'administrateur, comme « waydroid shell »
# avant lui (voir s_android_dans dans partage-android.sh) : un garde qui
# lirait la valeur demanderait donc le mot de passe A CHAQUE lancement
# d'Android, pour decouvrir neuf fois sur dix qu'il n'y a rien a faire. C'est
# le contraire de ce qu'on veut.
#
# On garde donc la trace de la VALEUR appliquee, pas le fait d'etre passe. La
# nuance est celle que ce carnet reproche aux marqueurs de premier demarrage de
# l'amont : un marqueur qui dit « c'est fait » empeche tout correctif futur ;
# un marqueur qui dit « j'ai applique 2147483647 » se perime tout seul le jour
# ou la valeur voulue change, et la machine recoit la nouvelle.
VEILLE_VOULUE=2147483647
VEILLE_VUE="$(cat "$S_ETAT/android-veille" 2>/dev/null || true)"
if [ "$VEILLE_VUE" != "$VEILLE_VOULUE" ]; then
    s_dire "Android" "Reglage de la mise en veille — un mot de passe va etre demande." phone
    if s_android_dans sh -c "
        settings put system screen_off_timeout ${VEILLE_VOULUE} &&
        settings put global stay_on_while_plugged_in 7
    " 2>&1 | s_tee "$S_ETAT/android-init.log"; then
        printf '%s\n' "$VEILLE_VOULUE" > "$S_ETAT/android-veille"
    fi
    # Rien n'est ecrit si pkexec echoue ou si l'utilisateur annule : le prochain
    # lancement reessaiera, plutot que de croire le travail fait.
fi

# --- LA COUCHE VIDEO, ET POURQUOI ELLE DISPARAISSAIT ------------------------
#
# En fenetre par application, une video jouee dans une SurfaceView laissait un
# TROU : on voyait le bureau au travers. Pas un ecran noir — rien du tout.
# Android decodait (la barre de progression avancait), l'application dessinait
# son interface, et la couche video n'arrivait nulle part.
#
# Ecarte par la mesure, dans cet ordre : les codecs (l'image declare 27
# decodeurs OMX dont vp9, vp8, opus, aac), le mode plein ecran (identique), et
# l'hote (kwin annonce NV12 et P010, wl_subcompositor et wp_viewporter sont la).
#
# LE LEVIER EST NOMME DANS LE BINAIRE DU COMPOSITEUR. « strings » sur
# /vendor/lib64/hw/hwcomposer.waydroid.so rend :
#
#     persist.waydroid.use_subsurface
#     persist.waydroid.no_background_subsurface
#     "usage of subsurfaces requested but wl_subcompositor is not supported."
#     wl_subsurface · wp_viewport · apply_hwc_layer_to_window
#
# Sans « use_subsurface », Waydroid compose les couches lui-meme au lieu de les
# confier a kwin comme sous-surfaces — et la couche video se perd en route.
# Elle etait vide sur cette machine.
#
# RESERVE ASSUMEE : ce reglage n'a PAS ete juge a l'ecran au moment ou ces
# lignes sont ecrites. Il est pose parce que le levier est nomme, eteint, et que
# kwin annonce les deux protocoles qu'il faut — pas parce qu'on l'a vu marcher.
# Si la video reste trouee, c'est ici qu'il faut revenir, et le compromis
# suivant est « multi_windows », qui est un choix d'usage et non technique.
# « false » N'EST PAS « on n'y touche pas » : c'est ce qui choisit la variante
# COMPOSITING du mode fenetre unique. « true » demanderait des sous-surfaces —
# essaye dans les deux sens le 2026-08-25, sans effet sur la video, et c'est la
# variante non-compositing. C'est desormais UNE propriete de demarrage parmi
# les autres — verifiee et ecrite au meme endroit qu'en tete de script (voir
# « TOUTES LES PROPRIETES DE DEMARRAGE... » plus haut), plus de « prop set »
# separe ici.

# --- Poser le magasin, une seule fois PAR JEU DE DONNEES --------------------
#
# LE MARQUEUR VIDE ETAIT LE DEFAUT QUE CE CARNET REPROCHE A L'AMONT, ET IL A
# MORDU ICI MEME : le test a froid du 2026-08-28 a efface les donnees
# Android — F-Droid avec — pendant que « android-pret » (2026-08-25)
# continuait de dire « pose ». Mesure du 2026-08-29 : « pm list packages »
# ne rend plus org.fdroid.fdroid, marqueur present.
#
# Le marqueur porte donc desormais l'EMPREINTE du dossier de donnees (inode,
# lisible sans droit d'entrer dedans — c'est le dossier parent, dans le
# HOME, qui autorise le stat). Donnees effacees et recreees = autre inode =
# marqueur perime tout seul, et le bloc rejoue.
DONNEES_ANDROID="$HOME/.local/share/waydroid/data"
EMPREINTE_DONNEES="$(stat -c %i "$DONNEES_ANDROID" 2>/dev/null || echo aucune)"
if [ "$(cat "$MARQUE" 2>/dev/null)" != "$EMPREINTE_DONNEES" ]; then
    # LE MARQUEUR NE S'ECRIT QUE SI F-DROID EST REELLEMENT LA A LA FIN — pas
    # parce qu'on est passe par ici. Le 2026-08-29 le bloc a ecrit son
    # marqueur apres une reinstallation lancee trop tot et echouee (voir la
    # course plus haut) : « pose » sans rien de pose.
    FDROID_LA=0
    if s_android_dans pm list packages 2>/dev/null | grep -q 'org\.fdroid\.fdroid'; then
        FDROID_LA=1
    elif [ -f "$APK_MAISON/fdroid.apk" ]; then
        s_dire "Android" "Installation du magasin F-Droid…" phone
        # tee depuis CE shell (jamais une redirection donnee a lxc-attach), et
        # le verdict se lit dans la sortie de pm : « Success », rien d'autre.
        SORTIE_INSTALL="$(s_android_installer "$APK_MAISON/fdroid.apk" 2>&1 \
                          | tee -a "$S_ETAT/android-init.log")"
        case "$SORTIE_INSTALL" in *Success*) FDROID_LA=1 ;; esac
    fi

    # AUTORISER F-DROID A INSTALLER, PAR AVANCE.
    #
    # Le 2026-08-23, une installation depuis F-Droid a GELE le bureau sur
    # l'ecran « autoriser l'installation depuis des sources inconnues ». Cet
    # ecran est dessine par « packageinstaller », un composant d'Android, et
    # l'hypothese la plus plausible est qu'il s'ouvre dans une fenetre que le
    # multi-fenetrage de Waydroid n'affiche pas — une fenetre invisible qui a
    # le focus ressemble exactement a un gel.
    #
    # On accorde donc l'autorisation d'avance, pour que la boite ne s'ouvre
    # jamais. « pm grant » NE MARCHE PAS ici : REQUEST_INSTALL_PACKAGES est
    # declaree « signature|appop » dans AOSP, et pm grant ne traite que les
    # permissions demandees a l'execution. C'est « appops » qu'il faut.
    #
    # RESERVE, ET ELLE COMPTE : cela supprime l'ecran d'autorisation — celui
    # qui a gele — mais PAS la confirmation finale « voulez-vous installer
    # cette application ? », dessinee par le meme composant. Le chemin qui
    # n'ouvre aucune boite du tout est « Magasin Android » (s-magasin-android),
    # qui installe depuis l'hote.
    if [ "$FDROID_LA" = 1 ]; then
        s_android_dans cmd appops set org.fdroid.fdroid \
            REQUEST_INSTALL_PACKAGES allow 2>&1 | s_tee "$S_ETAT/android-init.log" || \
            s_dire "Android" \
"F-Droid n'a pas pu recevoir l'autorisation d'installer. Utiliser plutot \
« Magasin Android », qui installe sans passer par Android." dialog-warning
        printf '%s\n' "$EMPREINTE_DONNEES" > "$MARQUE"
    else
        # Pas de marqueur : le prochain lancement reessaiera, plutot que de
        # croire le travail fait.
        s_dire "Android" "F-Droid n'a pas pu etre pose cette fois — S reessaiera au prochain lancement." dialog-warning
    fi
fi

# --- Le Play Store : une seule declaration, imposee par Google --------------
# Elle ne peut pas etre automatisee jusqu'au bout — il faut un humain connecte
# a son compte Google. s-play-store fait tout le reste : il lit
# l'identifiant, le copie, et ouvre la page. Il se tait s'il a deja servi.
if [ ! -f "$S_ETAT/android-certifie" ]; then
    s_dire "Play Store" "Google demande a connaitre cet appareil. Un mot de passe va etre demande, une seule fois."
    s-play-store && touch "$S_ETAT/android-certifie" || true
fi

# AUCUNE ICONE PAR APPLICATION N'EST PLUS POSEE AUTOMATIQUEMENT. C'etait le
# demon Python de Waydroid (AppsService) qui les generait a chaque
# installation ; il est parti avec le paquet, et rien ne le remplace encore
# — voir CLAUDE.md, 2026-08-29. Rafraichir le menu reste utile pour tout ce
# que d'autres gestes de S y posent.
s_rafraichir_menu

# CE QUI SUIT EST FORGE DEPUIS LES OUTILS AOSP STANDARDS (am, cmd package),
# JAMAIS EPROUVE SUR CETTE IMAGE ANDROID PRECISE — voir CLAUDE.md,
# 2026-08-29. Et ce n'est plus un simple confort comme avant : sans un appel
# qui met une activite Android au premier plan, demarrer seul le conteneur
# pourrait ne rendre aucune fenetre visible — hwcomposer compose une fenetre
# a partir de l'activite EN COURS, jamais toute seule.
#
# UN SEUL s_android_dans pour toute la cascade : chaque appel est un pkexec,
# donc une demande de mot de passe — trois replis en trois appels separes en
# feraient jusqu'a trois d'affilee pour un seul clic.
if [ "${1:-}" = "--magasin" ]; then
    # Le Play Store d'abord : c'est le magasin que l'image GAPPS apporte.
    # « setprop waydroid.active_apps » avant chaque « am start » : c'est la
    # propriete que hwcomposer lit pour creer la fenetre Wayland — voir
    # s_android_lancer dans partage-android.sh pour la mesure.
    s_android_dans sh -c '
        for paquet in com.android.vending org.fdroid.fdroid; do
            resolu="$(cmd package resolve-activity --brief "$paquet" 2>/dev/null | tail -1)"
            case "$resolu" in
                */*)
                    setprop waydroid.active_apps "$paquet"
                    exec am start -n "$resolu"
                    ;;
            esac
        done
        setprop waydroid.active_apps Waydroid
        exec am start -a android.intent.action.MAIN -c android.intent.category.HOME
    '
else
    s_android_accueil
fi
