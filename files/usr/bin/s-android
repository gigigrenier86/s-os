#!/usr/bin/bash
# Le monde Android de S : le preparer, le demarrer, et ne rien montrer.
#
# Android EST Linux, et son espace utilisateur tourne dans un conteneur sur le
# noyau de la machine — par lxc-start direct (s-android.service,
# android-lancer.sh) depuis le 2026-08-28, sans l'outillage Python de
# Waydroid. Ce script est le SEUL chemin de demarrage d'Android : la session
# l'appelle a son ouverture (s-android-demarrer.service, « --silencieux »),
# la barre laterale de Constellation l'appelle pour rallumer, et
# « Play Store » l'appelle avec « --magasin ».
#
# CE QU'IL NE FAIT PLUS DEPUIS LE 2026-08-29 AU SOIR : ouvrir l'interface
# complete d'Android (« la fenetre Waydroid »). L'utilisateur ne veut plus
# la voir ; chaque application a son icone au menu et au ciel
# (android-applications.py), et s'ouvre dans sa propre fenetre
# (s-android-lancer). La valeur « Waydroid » de waydroid.active_apps n'est
# plus posee nulle part dans ce depot.
#
# ET IL NE DEMANDE PLUS DE MOT DE PASSE, sauf sur une machine qui n'a pas
# encore 50-s-android.rules : tout ce qui parle a Android en marche passe par
# le service binder « waydroidplatform » (android_plateforme.py, sans
# privilege) ; seules les proprietes de DEMARRAGE (un fichier root:root) et
# le « systemctl start » gardent un privilege — le second couvert par polkit.
#
#   s-android                 preparer + demarrer, ne rien ouvrir
#   s-android --silencieux    pareil, sans phrase de fin (l'ouverture de session)
#   s-android --magasin       pareil, puis ouvrir le Play Store
set -uo pipefail
source /usr/bin/s-monde

MARQUE="$S_ETAT/android-pret"
APK_MAISON=/usr/share/s/apk
LANCEUR="${S_BIN:-/usr/bin}/s-android-lancer"
[ -x "$LANCEUR" ] || LANCEUR=/usr/bin/s-android-lancer
MODE="${1:-}"

# EN MODE SILENCIEUX (l'ouverture de session), AUCUNE BULLE — demande de
# l'utilisateur le 2026-08-29 : « je ne veux pas le voir du tout ». Avant
# cette fonction, seule la phrase « Demarrage… » etait gardee ; six autres
# s_dire de ce script (reglage d'affichage, redemarrage, avertissement de
# depassement, veille, F-Droid) pouvaient encore surgir a l'ouverture de
# session — un rattrapage au cas par cas aurait fini par en oublier une,
# exactement le genre de garde disperse que ce depot regrette ailleurs. Un
# seul point de passage : le journal recoit toujours la phrase
# (« journalctl --user -u s-android-demarrer » reste le recours), la bulle
# jamais en mode silencieux.
_dire_android() {
    if [ "$MODE" = "--silencieux" ]; then
        printf '%s — %s\n' "$1" "${2:-}" >&2
        return 0
    fi
    s_dire "$@"
}

s_verrou android

# --- Premiere utilisation : IL N'Y A PLUS DE TELECHARGEMENT -----------------
#
# CE BLOC FAISAIT « waydroid init -s GAPPS -c ... -v ... » — le seul chemin
# qui ait jamais pose system.img/vendor.img sur une machine neuve. Le paquet
# waydroid, et son initialiseur Python, sont partis avec lui le 2026-08-29 :
# IL N'EXISTE PLUS AUCUN MOYEN NATIF DE TELECHARGER ANDROID.
#
# CETTE MACHINE-CI a deja ses images (residu du 2026-08-25, pose avant le
# retrait) — le geste marche donc ICI. Une machine reconstruite a neuf n'aurait
# ni system.img ni vendor.img, et rien dans ce depot ne saurait plus les poser
# : il faudrait reproduire la logique OTA de l'ancien initializer.py (deux URL
# JSON, extraction). NON COMMENCE, chantier a part — voir CLAUDE.md,
# 2026-08-29.
#
# On verifie donc que ce qu'il faut est bien la, et on le DIT honnetement si ce
# n'est pas le cas plutot que de pretendre pouvoir le reparer.
if [ ! -f /var/lib/waydroid/images/system.img ] || \
   [ ! -f /var/lib/waydroid/images/vendor.img ]; then
    s_echec "Android n'est pas prepare sur cette machine" \
"system.img ou vendor.img manque dans /var/lib/waydroid/images, et S ne sait \
plus les telecharger depuis le retrait de Waydroid — voir CLAUDE.md, \
2026-08-29."
fi

# --- Android en FENETRES — ET LE MODE A CHANGE LE 2026-08-25 AU SOIR --------
#
# CE QUE CE BLOC DISAIT AVANT, ET QUI ETAIT VRAI A MOITIE. Il posait
# « multi_windows = true » et expliquait que sans lui, Waydroid rend une seule
# surface plein ecran ou vit tout Android. C'est vrai du mode « full_ui », et
# c'est faux du mode qu'on emploie desormais.
#
# CE QUE MULTI_WINDOWS COUTAIT, MESURE SUR LA MACHINE. Une video jouee dans une
# application Android laissait un TROU : on voyait le bureau au travers. Pas un
# ecran noir — rien. Le son marchait, la barre de progression avancait, les
# sous-titres s'affichaient PAR-DESSUS le vide. Seule la surface video manquait.
#
# LA CAUSE, LUE DANS LA TABLE DES SYMBOLES DE hwcomposer.waydroid.so :
#
#     compositing_full_ui_mode        / non_compositing_full_ui_mode
#     compositing_single_window_mode  / non_compositing_single_window_mode
#     multi_window_mode               <- SEUL, sans variante « compositing »
#
# « full_ui » et « single_window » ont chacun une variante qui COMPOSE les
# couches d'Android ensemble avant de les rendre. « multi_window_mode » n'en a
# pas : il ne sait que faire correspondre UNE couche a UNE fenetre — d'ou son
# « can_handle_layer() », et d'ou la couche video qui n'a nulle part ou aller.
#
# CE QU'ON EMPLOIE A LA PLACE. « multi_windows = false » AVEC un lancement
# par paquet (s-android-lancer) ne donne PAS le plein ecran d'Android : il
# donne « compositing_single_window_mode » — une fenetre qui ne montre que
# l'application, sans barre d'etat, sans lanceur, et dont le compositeur
# assemble lui-meme toutes les couches. La video y est.
#
# C'est la regle 9 du projet appliquee jusqu'au bout : une couture ne montre
# jamais son moteur. Une icone, un clic, l'application — et rien d'Android.
#
# CE QUE CA COUTE, ET IL FAUT LE DIRE. Waydroid ne tient qu'UNE fenetre Android
# a la fois dans ce mode : ouvrir Gmail pendant que YouTube tourne remplace la
# fenetre au lieu d'en ajouter une. C'est le prix, il est connu, et il vaut
# mieux qu'une video invisible.
#
# LA PROPRIETE SE POSE AVANT LE DEMARRAGE DU CONTENEUR, PAS APRES : elle est
# lue quand il monte. Posee a chaud, elle ne prend qu'au prochain demarrage.
#
# IL N'Y A QU'UN SEUL FICHIER A LIRE : android-lancer.sh bind-monte
# directement /var/lib/waydroid/waydroid.prop dans le conteneur a CHAQUE
# demarrage — le lire (s_android_prop_lire) dit exactement ce qui sera
# applique au prochain demarrage. waydroid.cfg et waydroid_base.prop sont
# morts avec le paquet (voir partage-android.sh).
#
#   ro.sf.lcd_density = 140 — la valeur livree est 180, pensee pour un ecran de
#   telephone tenu a trente centimetres. A 140, l'interface redevient celle
#   d'un ecran, pas d'une loupe.
#
#   persist.waydroid.use_subsurface = false — c'est ce qui choisit la variante
#   COMPOSITING du mode fenetre unique (« true » demanderait des sous-surfaces,
#   essaye dans les deux sens le 2026-08-25, sans effet sur la video).
#
# LE GARDE PORTE SUR CHAQUE REGLAGE, PAS SUR UN SEUL. Une machine qui a recu
# le premier avant que les autres n'existent doit encore les recevoir.
#
# --- LA TAILLE DE LA FENETRE ANDROID, ET POURQUOI ELLE NE PEUT PAS ETRE PLEINE
#
# TROUVE LE 2026-08-26, A L'ECRAN, EN REGARDANT YOUTUBE. Son ecran d'accueil
# servait UNE colonne. Deux hypotheses sont mortes avant la bonne (la densite,
# « characteristics=tablet »). CE QUI DECIDE EST LE QUALIFICATEUR « long »
# D'ANDROID : un ecran dont le rapport long/court atteint 1,75 est un
# telephone en paysage, et YouTube lui sert sa mise en page telephone.
#
#   1920 x 1028  ->  rapport 1,868  ->  xlarge-long-     ->  une colonne
#   1700 x 1028  ->  rapport 1,654  ->  xlarge-notlong-  ->  trois colonnes
#
# On calcule donc la largeur au lieu de la coder en dur. La hauteur retire la
# barre de S. Le rapport vise est 1,70 et non 1,74 : le seuil d'AOSP est un
# flottant, on ne se pose pas a un centieme d'une bascule qu'on ne controle pas.
S_ECRAN_MODE=""
for _m in /sys/class/drm/card*-*/modes; do
    [ -s "$_m" ] || continue
    S_ECRAN_MODE="$(head -1 "$_m" 2>/dev/null)"
    [ -n "$S_ECRAN_MODE" ] && break
done
S_FEN_L=""; S_FEN_H=""
case "$S_ECRAN_MODE" in
    [0-9]*x[0-9]*)
        # LA FORMULE N'EST PAS ICI, ET C'EST VOULU. Elle vit dans
        # regles-kwin.py, ou la coquille la lit pour CENTRER cette meme
        # fenetre. Deux formules qui doivent rester d'accord finissent par
        # diverger — ce depot l'a paye sur s-partage, sur les roles, et sur
        # s-session.target.
        read -r S_FEN_L S_FEN_H < <(
            /usr/bin/python3 - "${S_LIB:-/usr/lib/s}" \
                "${S_ECRAN_MODE%%x*}" "${S_ECRAN_MODE##*x}" <<'PY' 2>/dev/null || true
import importlib.util, os, sys
lib, larg, haut = sys.argv[1], int(sys.argv[2]), int(sys.argv[3])
spec = importlib.util.spec_from_file_location(
    "regles_kwin", os.path.join(lib, "regles-kwin.py"))
mod = importlib.util.module_from_spec(spec)
spec.loader.exec_module(mod)
print("%d %d" % mod.taille_android(larg, haut))
PY
        )
        ;;
esac
# Si on ne sait pas lire l'ecran, on ne devine pas : le fichier de proprietes
# garde ses valeurs actuelles plutot qu'une fenetre calculee sur une
# supposition.

# TOUTES LES PROPRIETES DE DEMARRAGE SE LISENT DANS LE MEME FICHIER : une
# seule ecriture, un seul mot de passe si quelque chose manque — et rien du
# tout neuf fois sur dix, quand tout est deja la.
manque=0
[ "$(s_android_prop_lire ro.sf.lcd_density)" = "140" ] || manque=1
[ "$(s_android_prop_lire persist.waydroid.multi_windows)" = "false" ] || manque=1
[ "$(s_android_prop_lire persist.waydroid.use_subsurface)" = "false" ] || manque=1
if [ -n "$S_FEN_L" ]; then
    [ "$(s_android_prop_lire persist.waydroid.width)" = "$S_FEN_L" ] || manque=1
    [ "$(s_android_prop_lire persist.waydroid.height)" = "$S_FEN_H" ] || manque=1
fi
if [ "$manque" = 1 ]; then
    _dire_android "Android" "Reglage de l'affichage — un mot de passe va etre demande, une seule fois." phone
    ANDROID_ETAIT_LA="$(s_android_etat)"
    if [ -n "$S_FEN_L" ]; then
        s_android_prop_ecrire \
            "ro.sf.lcd_density=140" \
            "persist.waydroid.multi_windows=false" \
            "persist.waydroid.use_subsurface=false" \
            "persist.waydroid.width=$S_FEN_L" \
            "persist.waydroid.height=$S_FEN_H"
    else
        s_android_prop_ecrire \
            "ro.sf.lcd_density=140" \
            "persist.waydroid.multi_windows=false" \
            "persist.waydroid.use_subsurface=false"
    fi
    # NE PREND EFFET QU'AU PROCHAIN DEMARRAGE DU CONTENEUR : on ne redemarre
    # que s'il tournait deja (sinon la section suivante le demarrera avec le
    # fichier deja a jour, un seul redemarrage au lieu de deux).
    if [ "$ANDROID_ETAIT_LA" = "RUNNING" ]; then
        _dire_android "Android" "Redemarrage pour appliquer les reglages…" phone
        s_android_service restart
    fi
fi

# --- Demarrer le conteneur, et attendre qu'Android reponde -----------------
#
# « RUNNING » cote lxc veut dire « /init a demarre », pas « Android est
# utilisable » (la course mesuree le 2026-08-29 : pm list 3 s apres /init,
# « Can't find service: package »). Le temoin est « sys.boot_completed » —
# lu ici SANS PRIVILEGE, par le service binder waydroidplatform
# (s-android-lancer --attendre), la ou la version precedente le lisait par
# lxc-attach sous pkexec, dans la meme elevation que le demarrage. Le
# demarrage lui-meme passe par systemctl, que 50-s-android.rules autorise
# sans mot de passe ; s_android_service retombe sur pkexec si la regle
# manque (machine pas encore a jour), comme avant.
if [ "$(s_android_etat)" != "RUNNING" ]; then
    _dire_android "Android" "Demarrage…" phone
    s_android_service start
fi
[ "$(s_android_etat)" = "RUNNING" ] || \
    s_echec "Android n'a pas demarre" "Voir : sudo journalctl -u s-android.service"

if ! "$LANCEUR" --attendre 240; then
    _dire_android "Android" \
"Le conteneur tourne mais Android n'a pas annonce la fin de son demarrage \
en 240 s. La suite peut echouer." dialog-warning
fi

# --- EMPECHER ANDROID DE S'ENDORMIR ----------------------------------------
#
# LE DEFAUT, MESURE LE 2026-08-25 AU SOIR, ET IL NE RESSEMBLAIT PAS A CA.
# L'utilisateur a rapporte « aucune connexion internet » dans les applications
# Android, alors que l'hote avait internet. Releve dans le conteneur :
#
#     ip route          → 192.168.240.0/24 dev eth0 ... et RIEN d'autre
#     getprop net.dns1  → (vide)
#     ping 8.8.8.8      → Network is unreachable
#
# LA CAUSE, LUE DANS waydroid.log : lxc-freeze → FROZEN, et le compteur du
# pont waydroid0 fige. Un conteneur gele, ce sont TOUS ses processus arretes :
# plus de pile reseau, plus de bail DHCP. Au degel, Android ne recupere ni sa
# route ni son DNS.
#
# LE LEVIER EST DE L'AUTRE COTE. Le gel n'est pas decide par l'hote : Android
# le DEMANDE, en appelant suspend() quand il eteint son ecran. Un ecran qui ne
# s'eteint jamais ne demande jamais rien. MESURE : 25 gels dans la journee,
# AUCUN apres ces deux reglages.
#
# LE GARDE INTERROGE ANDROID, JAMAIS UN FICHIER — et c'est une lecon payee
# DEUX FOIS. La version precedente gardait un marqueur hote (« j'ai applique
# 2147483647 ») parce que lire la valeur exigeait pkexec ; le 2026-08-29,
# ce marqueur disait « applique » pendant qu'Android, dont les donnees
# avaient ete effacees le 28, repondait 60000 — la valeur a neuf. Le service
# binder lit et ecrit sans privilege : on relit a chaque demarrage, rien a
# garder cote hote.
"$LANCEUR" --veille || \
    _dire_android "Android" "La mise en veille d'Android n'a pas pu etre desarmee — le reseau Android pourra tomber apres un gel." dialog-warning

# --- Poser le magasin, une seule fois PAR JEU DE DONNEES --------------------
#
# LE MARQUEUR VIDE ETAIT LE DEFAUT QUE CE CARNET REPROCHE A L'AMONT, ET IL A
# MORDU ICI MEME : le test a froid du 2026-08-28 a efface les donnees
# Android — F-Droid avec — pendant que « android-pret » (2026-08-25)
# continuait de dire « pose ». Le marqueur porte donc l'EMPREINTE du dossier
# de donnees (inode) : donnees effacees et recreees = autre inode = marqueur
# perime tout seul, et le bloc rejoue.
#
# ET ON NE DEMANDE PLUS A F-DROID L'AUTORISATION D'INSTALLER (« appops »,
# le seul reste qui exigeait lxc-attach) : personne n'installe plus depuis
# son interface, « Magasin Android » installe depuis l'hote sans ouvrir
# Android. F-Droid reste pose comme catalogue et comme magasin de secours si
# Google refuse l'appareil.
DONNEES_ANDROID="$HOME/.local/share/waydroid/data"
EMPREINTE_DONNEES="$(stat -c %i "$DONNEES_ANDROID" 2>/dev/null || echo aucune)"
if [ "$(cat "$MARQUE" 2>/dev/null)" != "$EMPREINTE_DONNEES" ]; then
    # LE MARQUEUR NE S'ECRIT QUE SI F-DROID EST REELLEMENT LA A LA FIN — pas
    # parce qu'on est passe par ici.
    FDROID_LA=0
    if "$LANCEUR" --present org.fdroid.fdroid; then
        FDROID_LA=1
    elif [ -f "$APK_MAISON/fdroid.apk" ]; then
        _dire_android "Android" "Installation du magasin F-Droid…" phone
        "$LANCEUR" --installer "$APK_MAISON/fdroid.apk" 2>&1 | s_tee "$S_ETAT/android-init.log"
        "$LANCEUR" --present org.fdroid.fdroid && FDROID_LA=1
    fi
    if [ "$FDROID_LA" = 1 ]; then
        printf '%s\n' "$EMPREINTE_DONNEES" > "$MARQUE"
    else
        # Pas de marqueur : le prochain lancement reessaiera, plutot que de
        # croire le travail fait.
        _dire_android "Android" "F-Droid n'a pas pu etre pose cette fois — S reessaiera au prochain lancement." dialog-warning
    fi
fi

# --- Le Play Store : une seule declaration, imposee par Google --------------
# Elle ne peut pas etre automatisee jusqu'au bout — il faut un humain connecte
# a son compte Google. s-play-store fait tout le reste : il lit
# l'identifiant, le copie, et ouvre la page. Il se tait s'il a deja servi.
# JAMAIS a l'ouverture de session : c'est le seul geste de ce script qui
# demande encore un mot de passe (sqlite dans le conteneur, par lxc-attach),
# et une session qui s'ouvre sur une demande de mot de passe pour Google
# n'est pas ce qu'on veut. Il attend le premier clic « Play Store ».
if [ "$MODE" = "--magasin" ] && [ ! -f "$S_ETAT/android-certifie" ]; then
    _dire_android "Play Store" "Google demande a connaitre cet appareil. Un mot de passe va etre demande, une seule fois."
    s-play-store && touch "$S_ETAT/android-certifie" || true
fi

# Les icones par application sont l'affaire d'android-applications.py
# (service utilisateur, toujours en marche) — rien a poser ici. Rafraichir le
# menu reste utile pour tout ce que d'autres gestes de S y posent.
s_rafraichir_menu

# --- Et ne rien montrer, sauf ce qu'on a demande ----------------------------
case "$MODE" in
    --magasin)
        "$LANCEUR" com.android.vending || "$LANCEUR" org.fdroid.fdroid || \
            s_echec "Aucun magasin" "Ni le Play Store ni F-Droid ne sont installes dans Android."
        ;;
    --silencieux) ;;
    *) _dire_android "Android" "Android est pret : ses applications sont au menu." phone ;;
esac
