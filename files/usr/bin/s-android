#!/usr/bin/bash
# Le monde Android de S : une seule icone qui fait tout.
#
# Waydroid n'est pas une machine virtuelle : Android EST Linux, et son espace
# utilisateur tourne dans un conteneur sur le noyau de la machine. Mais son
# image systeme (~1 Go) vit dans /var, que le systeme atomique ne transporte
# pas : elle se pose donc au premier usage, une fois, et jamais plus.
set -uo pipefail
source /usr/bin/s-monde

MARQUE="$S_ETAT/android-pret"
APK_MAISON=/usr/share/s/apk

s_verrou android

# --- Premiere utilisation ---------------------------------------------------
if [ ! -f /var/lib/waydroid/waydroid.cfg ]; then
    s_dire "Premiere utilisation d'Android" "Telechargement du systeme Android, environ 1 Go. Une seule fois."
    # GAPPS plutot que VANILLA : c'est la variante qui porte le Play Store.
    # Elle exige un enregistrement de l'appareil chez Google, une seule fois ;
    # la suite du script s'en occupe.
    # LES DEUX URL NE SONT PAS FACULTATIVES, ET LEUR ABSENCE NE SE VOIT PAS.
    #
    # waydroid lit ses canaux dans /usr/share/waydroid-extra/channels.cfg —
    # fourni par le paquet « waydroid-extra », ABSENT de cette image (verifie
    # le 2026-08-25 : rpm -q waydroid-extra le dit non installe). Sans lui,
    # system_channel et vendor_channel valent la chaine vide, et l'initialiseur
    # s'arrete sur « You must provide 'System OTA' and 'Vendor OTA' URLs ».
    #
    # C'est exactement ce que la recette de l'amont passe en clair, dans
    # /usr/share/ublue-os/just/82-bazzite-waydroid.just : S avait reecrit
    # l'appel en laissant tomber ses deux arguments. La regle du carnet — on ne
    # reimplemente pas ce que l'amont maintient — vaut aussi pour une ligne de
    # commande.
    # 3600 s : ce n'est pas l'authentification qui est longue, c'est le
    # gigaoctet d'image Android qui se telecharge derriere. Une limite courte
    # couperait un travail legitime au milieu.
    if ! s_root --limite 3600 waydroid init -s GAPPS \
            -c 'https://ota.waydro.id/system' \
            -v 'https://ota.waydro.id/vendor' >"$S_ETAT/android-init.log" 2>&1; then
        s_echec "Android n'a pas pu etre prepare" "Detail dans $S_ETAT/android-init.log"
    fi
fi

# --- Android en FENETRES — ET LE MODE A CHANGE LE 2026-08-25 AU SOIR --------
#
# CE QUE CE BLOC DISAIT AVANT, ET QUI ETAIT VRAI A MOITIE. Il posait
# « multi_windows = true » et expliquait que sans lui, Waydroid rend une seule
# surface plein ecran ou vit tout Android. C'est vrai du mode « full_ui », et
# c'est faux du mode qu'on emploie desormais.
#
# CE QUE MULTI_WINDOWS COUTAIT, MESURE SUR LA MACHINE. Une video jouee dans une
# application Android laissait un TROU : on voyait le bureau au travers. Pas un
# ecran noir — rien. Le son marchait, la barre de progression avancait, les
# sous-titres s'affichaient PAR-DESSUS le vide. Seule la surface video manquait.
#
# LA CAUSE, LUE DANS LA TABLE DES SYMBOLES DE hwcomposer.waydroid.so :
#
#     compositing_full_ui_mode        / non_compositing_full_ui_mode
#     compositing_single_window_mode  / non_compositing_single_window_mode
#     multi_window_mode               <- SEUL, sans variante « compositing »
#
# « full_ui » et « single_window » ont chacun une variante qui COMPOSE les
# couches d'Android ensemble avant de les rendre. « multi_window_mode » n'en a
# pas : il ne sait que faire correspondre UNE couche a UNE fenetre — d'ou son
# « can_handle_layer() », et d'ou la couche video qui n'a nulle part ou aller.
#
# Ce n'est donc pas un bogue de Waydroid : c'est une capacite que ce mode n'a
# jamais eue. Le releve de SurfaceFlinger le montrait sans qu'on sache le lire :
#
#     TID:23#…/HomeActivity#115      DEVICE  1920x1028   <- la fenetre, posee
#          …/HomeActivity(BLAST)#126 DEVICE  1280x714    <- la video, perdue
#
# CE QU'ON EMPLOIE A LA PLACE. « multi_windows = false » AVEC
# « waydroid app launch <paquet> » ne donne PAS le plein ecran d'Android : il
# donne « compositing_single_window_mode » — une fenetre qui ne montre que
# l'application, sans barre d'etat, sans barre de navigation, sans lanceur, et
# dont le compositeur assemble lui-meme toutes les couches. La video y est.
#
# C'est la regle 9 du projet appliquee jusqu'au bout : une couture ne montre
# jamais son moteur. Une icone, un clic, l'application — et rien d'Android.
#
# CE QUE CA COUTE, ET IL FAUT LE DIRE. Waydroid ne tient qu'UNE fenetre Android
# a la fois dans ce mode : ouvrir Gmail pendant que YouTube tourne remplace la
# fenetre au lieu d'en ajouter une. C'est le prix, il est connu, et il vaut
# mieux qu'une video invisible.
#
# CINQ HYPOTHESES ONT ETE REFUTEES AVANT CELLE-CI, toutes par la mesure : les
# codecs (27 decodeurs OMX presents), le plein ecran de l'application
# (identique), le masquage reseau (la regle existe et compte ses paquets),
# « use_subsurface » dans les deux sens (les couches restent DEVICE), et forcer
# la composition GPU par SurfaceFlinger (plus AUCUNE fenetre Android — ce qui a
# d'ailleurs livre le mecanisme : le compositeur fabrique les fenetres A PARTIR
# des couches DEVICE). Aucune n'est entree dans le depot.
#
# LA PROPRIETE SE POSE AVANT LE DEMARRAGE DE LA SESSION, PAS APRES : elle est
# lue quand le conteneur monte. Posee a chaud, elle ne prend qu'au demarrage
# suivant, et l'utilisateur conclurait qu'elle ne marche pas.
#
# Elle vit dans [properties] de waydroid.cfg, ce que la recette de l'amont
# prevoit pour cela — et pas dans un « prop set » qu'il faudrait rejouer.
#
# ET DEUX AUTRES REGLAGES QUI SE POSENT AU MEME ENDROIT, POUR LA MEME RAISON.
#
#   suspend_action = none — ET CE REGLAGE NE FAIT RIEN. C'est ecrit ici parce
#   que le carnet a affirme le contraire le 2026-08-25 au matin, et qu'il avait
#   tort. Le code de l'amont, hardware_manager.py:22-27 :
#
#       def suspend():
#           if cfg["waydroid"]["suspend_action"] == "stop":
#               session_manager.stop(args)
#           else:
#               container_manager.freeze(args)      # <- tout le reste tombe ici
#
#   Il n'y a que DEUX comportements : « stop », ou geler. « none » n'est
#   implemente nulle part dans waydroid 1.6.3 — le mot n'apparait pas une seule
#   fois dans tools/ — et tombe donc dans le else, ou il gele exactement comme
#   la valeur par defaut.
#
#   MESURE DU 2026-08-25 a 17 h, avec « suspend_action = none » deja pose dans
#   waydroid.cfg : « Session RUNNING / Container FROZEN ». Le gel est intact.
#
#   On garde la clef, inoffensive, et juste le jour ou l'amont implementera
#   « none ». Mais LE GEL N'EST PAS CORRIGE, et ce fichier ne doit plus laisser
#   croire qu'il l'est. Le seul autre choix offert — « stop » — arrete la
#   session entiere, ce qui est pire. Poser au hasard une propriete Android
#   pour empecher la mise en veille serait la faute que ce carnet s'interdit
#   depuis le halt de QEMU : une variable a la fois, et apres avoir regarde.
#
#   ro.sf.lcd_density = 140 — la valeur livree est 180, pensee pour un ecran de
#   telephone tenu a trente centimetres. Sur un 1920x1080 de bureau, tout est
#   demesure : Android croit avoir 1707 points de large la ou il en a 1920. A
#   140, il en compte 2194 et l'interface redevient celle d'un ecran, pas d'une
#   loupe. C'est un reglage de confort : il se change d'une ligne, et le carnet
#   dit laquelle.
# LE GARDE PORTE SUR LES TROIS REGLAGES, PAS SUR UN SEUL. Une machine qui a
# recu le premier avant que les deux autres n'existent doit encore les recevoir ;
# sinon le correctif ne rattrape que les installations neuves, ce qui est
# exactement la faute que ce carnet reproche aux marqueurs de premier demarrage.
# LE GARDE INTERROGE ANDROID, PAS LE FICHIER DE CONFIGURATION — CORRECTIF DU
# 2026-08-25 AU SOIR.
#
# Il lisait waydroid.cfg et concluait « c'est pose, il n'y a rien a faire ». Le
# carnet a repris cette lecture telle quelle et ecrit que les trois reglages
# etaient « appliques sur cette machine ». Ils ne l'etaient pas. Releve le
# 2026-08-25 a 17 h, sur la machine, session en marche :
#
#     waydroid.cfg          dit  ro.sf.lcd_density = 140
#     waydroid prop get     dit  180
#
# LA CAUSE, LUE DANS LE CODE DE L'AMONT. La section [properties] de
# waydroid.cfg n'est versee dans le conteneur que par make_base_props(), qui
# ecrit /var/lib/waydroid/waydroid_base.prop. Et make_base_props n'est appele
# que de deux endroits : initializer.py (waydroid init) et upgrader.py
# (waydroid upgrade). PAS au demarrage du conteneur, PAS au demarrage de la
# session. Releve : waydroid_base.prop date de 10 h 44, ne contient aucun des
# trois reglages, et le conteneur a demarre a 16 h 52 sans le regenerer.
#
# Donc tout ce qu'on ecrit dans [properties] APRES l'initialisation n'atteint
# jamais Android. multi_windows faisait exception, et par accident : c'est une
# propriete « persist. », que le prop set plus bas repose a chaque lancement et
# qu'Android garde dans son propre magasin.
#
# C'est le succes silencieux dans sa forme la plus exacte : le fichier disait
# vrai, la machine disait autre chose, et personne n'avait demande a la machine.
manque=0
if waydroid status 2>/dev/null | grep -qi 'RUNNING'; then
    # Session en marche : on demande a Android lui-meme. C'est la seule reponse
    # qui vaille, et celle que l'ancien garde n'allait pas chercher.
    [ "$(waydroid prop get ro.sf.lcd_density 2>/dev/null)" = "140" ] || manque=1
    [ "$(waydroid prop get persist.waydroid.multi_windows 2>/dev/null)" = "false" ] || manque=1
else
    # Session arretee : Android ne peut rien dire. On retombe sur le fichier, en
    # sachant que c'est une reponse plus faible.
    for reglage in 'persist.waydroid.multi_windows' 'ro.sf.lcd_density' 'suspend_action = none'; do
        grep -q "$reglage" /var/lib/waydroid/waydroid.cfg 2>/dev/null || manque=1
    done
fi
# waydroid_base.prop est ce qu'Android lit vraiment au demarrage du conteneur.
# S'il ne porte pas la densite, elle n'a jamais ete versee, quoi que dise
# waydroid.cfg — et c'est exactement l'etat trouve sur cette machine.
grep -q '^ro.sf.lcd_density=140' /var/lib/waydroid/waydroid_base.prop 2>/dev/null || manque=1
if [ "$manque" = 1 ]; then
    s_dire "Android" "Reglage de l'affichage — un mot de passe va etre demande, une seule fois." phone
    s_root /usr/bin/python3 - <<'PY' >/dev/null 2>&1 || true
import configparser, io
p = "/var/lib/waydroid/waydroid.cfg"
c = configparser.ConfigParser(interpolation=None, strict=False)
c.optionxform = str
c.read(p, encoding="utf-8")
if not c.has_section("properties"):
    c.add_section("properties")
c.set("properties", "persist.waydroid.multi_windows", "false")
c.set("properties", "ro.sf.lcd_density", "140")
# suspend_action vit dans [waydroid], pas dans [properties] : ce n'est pas une
# propriete Android, c'est une decision de waydroid lui-meme.
if c.has_section("waydroid"):
    c.set("waydroid", "suspend_action", "none")
t = io.StringIO()
c.write(t, space_around_delimiters=True)
io.open(p, "w", encoding="utf-8").write(t.getvalue())
PY
    # ECRIRE LA CONFIGURATION NE SUFFIT PAS — il faut la verser. Sans cette
    # ligne, ro.sf.lcd_density reste a 180 dans Android quoi qu'on ecrive, et
    # la seule trace du reglage est un fichier que personne ne lit.
    # « -o » : l'amont le decrit lui-meme comme « just for updating configs »
    # — pas de telechargement d'images, seulement la configuration lxc et
    # waydroid_base.prop, puis le conteneur repart s'il tournait. On ne
    # reimplemente donc rien : on appelle ce que l'amont maintient.
    s_dire "Android" "Application des reglages a Android…" phone
    s_root --limite 900 /usr/bin/waydroid upgrade -o >>"$S_ETAT/android-init.log" 2>&1 || true
fi

# --- Demarrer la session, si elle ne tourne pas -----------------------------
if ! waydroid status 2>/dev/null | grep -qi 'RUNNING'; then
    s_dire "Android" "Demarrage…" phone
    systemctl start waydroid-container 2>/dev/null || \
        s_root systemctl start waydroid-container >/dev/null 2>&1 || true
    waydroid session start >"$S_ETAT/android-session.log" 2>&1 &
    for _ in $(seq 1 60); do
        waydroid status 2>/dev/null | grep -qi 'RUNNING' && break
        sleep 2
    done
fi

waydroid status 2>/dev/null | grep -qi 'RUNNING' || \
    s_echec "Android n'a pas demarre" "Detail dans $S_ETAT/android-session.log"

# Une session deja lancee avant ce correctif garde son mode plein ecran : la
# propriete posee ici ne prendra qu'au prochain demarrage du conteneur. On la
# pose quand meme plutot que de laisser la machine dans deux etats differents.
if [ "$(waydroid prop get persist.waydroid.multi_windows 2>/dev/null)" != "false" ]; then
    waydroid prop set persist.waydroid.multi_windows false >/dev/null 2>&1 || true
fi

# --- EMPECHER ANDROID DE S'ENDORMIR ----------------------------------------
#
# LE DEFAUT, MESURE LE 2026-08-25 AU SOIR, ET IL NE RESSEMBLAIT PAS A CA.
# L'utilisateur a rapporte « aucune connexion internet » dans les applications
# Android, alors que l'hote avait internet et que le masquage reseau comptait
# ses paquets. Releve dans le conteneur :
#
#     ip route          → 192.168.240.0/24 dev eth0 ... et RIEN d'autre
#     getprop net.dns1  → (vide)
#     ping 8.8.8.8      → Network is unreachable
#
# Android avait son adresse et aucun moyen de sortir de son sous-reseau.
#
# LA CAUSE, LUE DANS waydroid.log :
#     17:55:52  lxc-freeze → FROZEN
#     17:58:32  FROZEN → lxc-unfreeze
# et pendant ce temps le compteur du pont waydroid0 fige a RX = 8862 paquets.
#
# Un conteneur gele, ce sont TOUS ses processus arretes : plus de pile reseau,
# plus d'ARP, plus de bail DHCP. Au degel, Android ne recupere ni sa route par
# defaut ni son DNS. Le gel ne casse donc pas que l'affichage — il casse le
# reseau, durablement, et rien ne le dit.
#
# ON NE PEUT PAS REFUSER LE GEL. « suspend_action » n'a que deux comportements
# dans waydroid 1.6.3 : « stop », qui arrete la session entiere, ou geler. La
# valeur « none » n'existe pas (voir le bloc des reglages plus haut).
#
# LE LEVIER EST DE L'AUTRE COTE. Le gel n'est pas decide par Waydroid : Android
# le DEMANDE, en appelant suspend() sur IHardware quand il eteint son ecran.
# Un ecran qui ne s'eteint jamais ne demande jamais rien. C'est une politique
# d'economie d'energie pensee pour un telephone dans une poche, appliquee a une
# fenetre de bureau — la meme famille que la densite de 180.
#
# MESURE SUR LA MACHINE : 25 gels dans la journee, le dernier a 17 h 55, AUCUN
# apres avoir pose ces deux reglages.
#
# Le garde interroge Android, jamais un fichier — la lecon de la journee.
# LE GARDE NE PEUT PAS INTERROGER ANDROID ICI, ET IL FAUT LE DIRE.
# « waydroid shell » exige les droits d'administrateur : un garde qui lirait la
# valeur demanderait donc le mot de passe A CHAQUE lancement d'Android, pour
# decouvrir neuf fois sur dix qu'il n'y a rien a faire. C'est le contraire de ce
# qu'on veut.
#
# On garde donc la trace de la VALEUR appliquee, pas le fait d'etre passe. La
# nuance est celle que ce carnet reproche aux marqueurs de premier demarrage de
# l'amont : un marqueur qui dit « c'est fait » empeche tout correctif futur ;
# un marqueur qui dit « j'ai applique 2147483647 » se perime tout seul le jour
# ou la valeur voulue change, et la machine recoit la nouvelle.
VEILLE_VOULUE=2147483647
VEILLE_VUE="$(cat "$S_ETAT/android-veille" 2>/dev/null || true)"
if [ "$VEILLE_VUE" != "$VEILLE_VOULUE" ]; then
    s_dire "Android" "Reglage de la mise en veille — un mot de passe va etre demande." phone
    if s_root /usr/bin/sh -c "
        waydroid shell -- settings put system screen_off_timeout ${VEILLE_VOULUE} &&
        waydroid shell -- settings put global stay_on_while_plugged_in 7
    " >>"$S_ETAT/android-init.log" 2>&1; then
        printf '%s\n' "$VEILLE_VOULUE" > "$S_ETAT/android-veille"
    fi
    # Rien n'est ecrit si pkexec echoue ou si l'utilisateur annule : le prochain
    # lancement reessaiera, plutot que de croire le travail fait.
fi

# --- LA COUCHE VIDEO, ET POURQUOI ELLE DISPARAISSAIT ------------------------
#
# En fenetre par application, une video jouee dans une SurfaceView laissait un
# TROU : on voyait le bureau au travers. Pas un ecran noir — rien du tout.
# Android decodait (la barre de progression avancait), l'application dessinait
# son interface, et la couche video n'arrivait nulle part.
#
# Ecarte par la mesure, dans cet ordre : les codecs (l'image declare 27
# decodeurs OMX dont vp9, vp8, opus, aac), le mode plein ecran (identique), et
# l'hote (kwin annonce NV12 et P010, wl_subcompositor et wp_viewporter sont la).
#
# LE LEVIER EST NOMME DANS LE BINAIRE DU COMPOSITEUR. « strings » sur
# /vendor/lib64/hw/hwcomposer.waydroid.so rend :
#
#     persist.waydroid.use_subsurface
#     persist.waydroid.no_background_subsurface
#     "usage of subsurfaces requested but wl_subcompositor is not supported."
#     wl_subsurface · wp_viewport · apply_hwc_layer_to_window
#
# Sans « use_subsurface », Waydroid compose les couches lui-meme au lieu de les
# confier a kwin comme sous-surfaces — et la couche video se perd en route.
# Elle etait vide sur cette machine.
#
# RESERVE ASSUMEE : ce reglage n'a PAS ete juge a l'ecran au moment ou ces
# lignes sont ecrites. Il est pose parce que le levier est nomme, eteint, et que
# kwin annonce les deux protocoles qu'il faut — pas parce qu'on l'a vu marcher.
# Si la video reste trouee, c'est ici qu'il faut revenir, et le compromis
# suivant est « multi_windows », qui est un choix d'usage et non technique.
# « false » N'EST PAS « on n'y touche pas » : c'est ce qui choisit la variante
# COMPOSITING du mode fenetre unique. « true » demanderait des sous-surfaces —
# essaye dans les deux sens le 2026-08-25, sans effet sur la video, et c'est la
# variante non-compositing. On pose donc la valeur explicitement plutot que de
# compter sur un defaut qui pourrait changer en amont.
if [ "$(waydroid prop get persist.waydroid.use_subsurface 2>/dev/null)" != "false" ]; then
    waydroid prop set persist.waydroid.use_subsurface false >/dev/null 2>&1 || true
fi

# --- Poser le magasin, une seule fois --------------------------------------
if [ ! -f "$MARQUE" ]; then
    if [ -f "$APK_MAISON/fdroid.apk" ] && \
       ! waydroid app list 2>/dev/null | grep -q 'org.fdroid.fdroid'; then
        s_dire "Android" "Installation du magasin F-Droid…" phone
        waydroid app install "$APK_MAISON/fdroid.apk" >>"$S_ETAT/android-init.log" 2>&1 || true
    fi

    # AUTORISER F-DROID A INSTALLER, PAR AVANCE.
    #
    # Le 2026-08-23, une installation depuis F-Droid a GELE le bureau sur
    # l'ecran « autoriser l'installation depuis des sources inconnues ». Cet
    # ecran est dessine par « packageinstaller », un composant d'Android, et
    # l'hypothese la plus plausible est qu'il s'ouvre dans une fenetre que le
    # multi-fenetrage de Waydroid n'affiche pas — une fenetre invisible qui a
    # le focus ressemble exactement a un gel.
    #
    # On accorde donc l'autorisation d'avance, pour que la boite ne s'ouvre
    # jamais. « pm grant » NE MARCHE PAS ici : REQUEST_INSTALL_PACKAGES est
    # declaree « signature|appop » dans AOSP, et pm grant ne traite que les
    # permissions demandees a l'execution. C'est « appops » qu'il faut.
    #
    # RESERVE, ET ELLE COMPTE : cela supprime l'ecran d'autorisation — celui
    # qui a gele — mais PAS la confirmation finale « voulez-vous installer
    # cette application ? », dessinee par le meme composant. Le chemin qui
    # n'ouvre aucune boite du tout est « Magasin Android » (s-magasin-android),
    # qui installe depuis l'hote.
    s_root waydroid shell -- cmd appops set org.fdroid.fdroid \
        REQUEST_INSTALL_PACKAGES allow >>"$S_ETAT/android-init.log" 2>&1 || \
        s_dire "Android" \
"F-Droid n'a pas pu recevoir l'autorisation d'installer. Utiliser plutot \
« Magasin Android », qui installe sans passer par Android." dialog-warning

    touch "$MARQUE"
fi

# --- Le Play Store : une seule declaration, imposee par Google --------------
# Elle ne peut pas etre automatisee jusqu'au bout — il faut un humain connecte
# a son compte Google. s-play-store fait tout le reste : il lit
# l'identifiant, le copie, et ouvre la page. Il se tait s'il a deja servi.
if [ ! -f "$S_ETAT/android-certifie" ]; then
    s_dire "Play Store" "Google demande a connaitre cet appareil. Un mot de passe va etre demande, une seule fois."
    s-play-store && touch "$S_ETAT/android-certifie" || true
fi

# Waydroid pose lui-meme une icone par application installee. On rafraichit
# pour qu'elles apparaissent sans attendre la prochaine ouverture de session.
s_rafraichir_menu

if [ "${1:-}" = "--magasin" ]; then
    # Le Play Store d'abord : c'est le magasin que l'image GAPPS apporte.
    waydroid app launch com.android.vending 2>/dev/null || \
    waydroid app launch org.fdroid.fdroid 2>/dev/null || \
    waydroid show-full-ui
else
    waydroid show-full-ui
fi
