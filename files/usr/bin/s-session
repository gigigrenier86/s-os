#!/usr/bin/bash
# La session S — ce que le greeter lance quand on choisit « S ».
#
# S N'ECRIT PAS SON PROPRE COMPOSITEUR, et ce n'est pas un renoncement.
# Un compositeur est precisement le morceau qu'on ne voit jamais : il ne met
# aucun nom a l'ecran, aucun logo, aucune couleur. Ce que l'utilisateur voit
# d'un bureau, c'est sa COQUILLE — la barre, le menu, les icones, le fond — et
# c'est elle que S remplace entierement par Constellation.
#
# Le compositeur retenu est celui de la base : il a deja affiche un bureau sur
# cette machine, il connait son GPU, il gere Xwayland, la mise a l'echelle et
# les manettes. En reecrire un donnerait moins bien, plus tard, et pour un
# resultat identique a l'ecran. C'est la regle « on ne reimplemente pas ce que
# l'amont maintient » appliquee la ou elle vaut.
#
# EN REVANCHE, RIEN DE LA COQUILLE D'ORIGINE NE DEMARRE : ni plasmashell, ni sa
# barre des taches, ni son menu, ni ses fenetres de bienvenue. C'est la
# difference entre habiller une base et en poser une autre par-dessus.
set -uo pipefail

# XDG_CURRENT_DESKTOP reste celui que la base connait, A DESSEIN : les portails
# (dialogues de fichiers, partage d'ecran, ouverture de liens) choisissent leur
# implementation par cette variable, et les applications Qt y lisent leur theme.
# Mettre « S » ici ne changerait rien de visible et casserait les deux. Le nom
# que l'utilisateur voit vient d'os-release et du fichier de session, pas d'ici.
export XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-KDE}"
export XDG_SESSION_DESKTOP=S
export QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-wayland;xcb}"
export MOZ_ENABLE_WAYLAND=1

JOURNAL="${XDG_STATE_HOME:-$HOME/.local/state}/s"
mkdir -p "$JOURNAL"

COMPOSITEUR=""
for essai in kwin_wayland labwc; do
    command -v "$essai" >/dev/null 2>&1 && { COMPOSITEUR="$essai"; break; }
done
if [[ -z "$COMPOSITEUR" ]]; then
    echo "s-session : aucun compositeur trouve." >&2
    exit 1
fi

# Un bus de session est indispensable : sans lui, ni notifications, ni portails,
# ni loginctl utilisable depuis la coquille. Le greeter en fournit un le plus
# souvent ; on ne le suppose pas.
if [[ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]] && command -v dbus-run-session >/dev/null 2>&1; then
    exec dbus-run-session -- "$0" "$@"
fi

# LE CLAVIER — sans ce bloc, S tape en QWERTY americain quoi qu'on ait choisi.
#
# Releve sur la machine le 2026-08-25, sur un kwin_wayland 6.7.4 neuf : le
# compositeur ne lit NI /etc/vconsole.conf, NI /etc/X11/xorg.conf.d/00-keyboard.conf,
# NI les variables XKB_DEFAULT_*. Il lit kxkbrc, groupe [Layout] — et ce fichier
# n'est ecrit que par le module de reglages clavier de Plasma, qui ne tourne pas
# ici puisque la coquille est Constellation. Faute de fichier, il retombe sur
# « us » et contredit en silence le clavier choisi a l'installation : localectl
# annoncait « ca » pendant que la session tapait en anglais. Encore un succes
# silencieux, pris par le bout ou personne ne regarde.
#
# On ecrit donc kxkbrc depuis la seule source de verite du systeme — celle que
# localectl tient a jour — et JAMAIS par-dessus un fichier existant : le jour ou
# l'utilisateur choisit sa disposition, c'est son choix qui doit tenir.
KXKB="${XDG_CONFIG_HOME:-$HOME/.config}/kxkbrc"
if [[ ! -s "$KXKB" && -r /etc/vconsole.conf ]]; then
    disposition="" variante="" modele=""
    while IFS='=' read -r clef valeur; do
        valeur="${valeur%\"}"; valeur="${valeur#\"}"
        case "$clef" in
            XKBLAYOUT)  disposition="$valeur" ;;
            XKBVARIANT) variante="$valeur" ;;
            XKBMODEL)   modele="$valeur" ;;
        esac
    done < /etc/vconsole.conf

    if [[ -n "$disposition" ]]; then
        mkdir -p "${KXKB%/*}"
        cat > "$KXKB" <<FIN
[Layout]
LayoutList=${disposition}
VariantList=${variante}
Model=${modele:-pc105}
Options=
ResetOldOptions=true
Use=true
FIN
        echo "s-session : clavier repris du systeme — ${disposition}${variante:+ (${variante})}" \
            >> "$JOURNAL/session.log"
    fi
fi

case "$COMPOSITEUR" in
    kwin_wayland)
        # --exit-with-session=, PAS un argument positionnel nu. Un positionnel
        # nu lance bien la coquille mais ne fait PAS terminer kwin quand elle
        # sort : la session resterait pendue apres une deconnexion, ecran vide,
        # rien a l'ecran, retour au greeter jamais fait. C'est exactement le
        # genre de panne que la session n'a jamais eue l'occasion de montrer,
        # puisqu'elle n'a jamais tourne avant le 2026-08-22.
        exec kwin_wayland --xwayland --exit-with-session=/usr/bin/s-coquille
        ;;
    labwc)
        exec labwc -s /usr/bin/s-coquille
        ;;
esac
